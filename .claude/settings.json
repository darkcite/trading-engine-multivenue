{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "description": "Claude Code settings for the multivenue trading engine. Model, permissions (git and .env laws as deny/ask rules) and the hook scripts that back CLAUDE.md's hard rules. Bash rules match command text only; guard-bash.py is the second line.",
  "model": "claude-opus-5-5",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(cargo check*)",
      "Bash(cargo build*)",
      "Bash(cargo test*)",
      "Bash(cargo nextest*)",
      "Bash(cargo clippy*)",
      "Bash(cargo bench*)",
      "Bash(cargo fuzz*)",
      "Bash(make *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(uv run *)",
      "Bash(uv sync*)",
      "Bash(uv pip list*)",
      "Bash(python -m pytest*)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(tree *)",
      "Bash(file *)",
      "WebFetch(domain:docs.polymarket.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:binance-docs.github.io)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list*)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:platform.claude.com)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git stash *)",
      "Bash(git merge *)",
      "Bash(git restore *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git tag *)",
      "Bash(git cherry-pick *)",
      "Bash(git clean *)",
      "Bash(cargo fmt *)",
      "Bash(cargo run *)",
      "Bash(launchctl *)",
      "Bash(pkill *)",
      "Bash(kill *)",
      "Bash(make run-paper*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(sudo *)",
      "Bash(pip install *)",
      "Bash(cargo publish*)",
      "Bash(npm *)",
      "Bash(yarn *)",
      "Bash(git rebase *)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(git branch -m *)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add -u*)",
      "Bash(git add .)",
      "Bash(git commit -a*)",
      "Bash(git commit --all*)",
      "Bash(git filter-branch *)",
      "Bash(git update-ref *)",
      "Bash(cargo fmt --all)",
      "Bash(cargo fmt)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Read(~/multivenue/*.env)",
      "Edit(~/multivenue/*.env)",
      "Bash(make fmt*)"
    ]
  },
  "env": {
    "CARGO_TERM_COLOR": "always",
    "RUSTFLAGS": "-C target-cpu=native",
    "RUST_BACKTRACE": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/statusline.sh\""
  },
  "outputStyle": "default",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/no-forbidden-crates.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit-fmt.sh\""
          }
        ]
      }
    ]
  }
}
