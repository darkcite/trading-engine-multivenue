//@version=6
indicator("B127", overlay = false)
// B127 · the 2024-10-28 20:00 UTC bar: volume, nvi, pvi · bar root · dialects 6 · generated by pine-conf gen; do not edit
w_B127 = time >= 1730138400000 and time <= 1730156400000
plot(w_B127 ? volume : na, "f_B127_vol", display = display.data_window)
plot(w_B127 ? ta.nvi - ta.nvi[1] : na, "f_B127_dnvi", display = display.data_window)
plot(w_B127 ? ta.pvi - ta.pvi[1] : na, "f_B127_dpvi", display = display.data_window)
plot(w_B127 ? close : na, "f_B127_c", display = display.data_window)
