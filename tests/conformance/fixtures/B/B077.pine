//@version=6
indicator("B077", overlay = false)
// B077 · ta.bb warm-up · B-wide · dialects 56 · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
[v1_B077, v2_B077, v3_B077] = ta.bb(syn, 14, 2.0)
plot(na(v1_B077) ? 1 : 0, "f_B077_isna1", display = display.data_window)
plot(na(v1_B077) ? na : v1_B077, "f_B077_val1", display = display.data_window)
plot(na(v2_B077) ? 1 : 0, "f_B077_isna2", display = display.data_window)
plot(na(v2_B077) ? na : v2_B077, "f_B077_val2", display = display.data_window)
plot(na(v3_B077) ? 1 : 0, "f_B077_isna3", display = display.data_window)
plot(na(v3_B077) ? na : v3_B077, "f_B077_val3", display = display.data_window)
