indicator("B045", overlay = false)
// B045 · ta.macd with len 200 · B-core × len_gt_bars · dialects 56 · pin:04-ta-reference · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
[m_B045, s_B045, h_B045] = ta.macd(syn, 200, 200, 200)
v_B045 = h_B045
plot(na(v_B045) ? 1 : 0, "f_B045_isna", display = display.data_window)
plot(na(v_B045) ? na : v_B045, "f_B045_val", display = display.data_window)
