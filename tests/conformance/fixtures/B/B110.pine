indicator("B110", overlay = false)
// B110 · ta.nvi on the chart · B-chart · dialects 56 · generated by pine-conf gen; do not edit
x_B110 = ta.nvi
v_B110 = x_B110 - x_B110[1]
plot(na(v_B110) ? 1 : 0, "f_B110_isna", display = display.data_window)
plot(na(v_B110) ? na : v_B110, "f_B110_val", display = display.data_window)
