//@version=6
indicator("B111", overlay = false)
// B111 · ta.obv on the chart · B-chart · dialects 56 · generated by pine-conf gen; do not edit
x_B111 = ta.obv
v_B111 = x_B111 - x_B111[1]
plot(na(v_B111) ? 1 : 0, "f_B111_isna", display = display.data_window)
plot(na(v_B111) ? na : v_B111, "f_B111_val", display = display.data_window)
