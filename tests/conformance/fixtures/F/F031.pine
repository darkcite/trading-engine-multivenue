//@version=6
indicator("F031", overlay = false)
// F031 · does a ta.* call in an untaken ternary arm advance? · dialects 56 · pin:U14-ternary-unselected-arm · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
probe_F031 = synb ? ta.sma(syn, 5) : 0.0
ref_F031   = ta.sma(syn, 5)
d_F031     = na(probe_F031) or na(ref_F031) ? na : probe_F031 - ref_F031
plot(na(d_F031) ? 1 : 0, "f_F031_isna", display = display.data_window)
plot(na(d_F031) ? na : d_F031, "f_F031_val", display = display.data_window)
