//@version=6
indicator("F124", overlay = false)
// F124 · constant folding of + - * / and a 16th-digit tie · dialects 56 · pin:02-fold-sig15-ties · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
plot(0.1 + 0.2, "f_F124_add", display = display.data_window)
plot(0.3 - 0.1, "f_F124_sub", display = display.data_window)
plot(0.1 * 3.0, "f_F124_mul", display = display.data_window)
plot(1.0 / 3.0, "f_F124_div", display = display.data_window)
plot(2.0 / 3.0, "f_F124_div2", display = display.data_window)
plot(1.0000000000000002, "f_F124_lit", display = display.data_window)
plot(1234567890123.125 % 1e15, "f_F124_tie", display = display.data_window)
plot(0.1 + 0.2 == 0.3 ? 1 : 0, "f_F124_eq", display = display.data_window)
