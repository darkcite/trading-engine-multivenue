indicator("F076", overlay = false)
// F076 · str.length(timeframe.from_seconds(s)), s in 86400, 604800, 3600 · dialects 6 · twin F075 · pin:00-tf-multiplier · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
plot(na(str.length(timeframe.from_seconds(86400))) ? 1 : 0, "f_F076_isna1", display = display.data_window)
plot(na(str.length(timeframe.from_seconds(86400))) ? na : str.length(timeframe.from_seconds(86400)), "f_F076_val1", display = display.data_window)
plot(na(str.length(timeframe.from_seconds(604800))) ? 1 : 0, "f_F076_isna2", display = display.data_window)
plot(na(str.length(timeframe.from_seconds(604800))) ? na : str.length(timeframe.from_seconds(604800)), "f_F076_val2", display = display.data_window)
plot(na(str.length(timeframe.from_seconds(3600))) ? 1 : 0, "f_F076_isna3", display = display.data_window)
plot(na(str.length(timeframe.from_seconds(3600))) ? na : str.length(timeframe.from_seconds(3600)), "f_F076_val3", display = display.data_window)
