//@version=6
indicator("F121", overlay = false)
// F121 · where a non-finite value becomes na · dialects 56 · pin:06-nonfinite · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
lg_F121 = math.log(close - close)
ex_F121 = syn * 1e303 * syn
plot(lg_F121 < 0 ? 1 : 0, "f_F121_lt", display = display.data_window)
plot(na(lg_F121) ? 1 : 0, "f_F121_lgna", display = display.data_window)
plot(ex_F121 > 0 ? 1 : 0, "f_F121_gt", display = display.data_window)
plot(na(ex_F121) ? 1 : 0, "f_F121_exna", display = display.data_window)
plot(nz(ex_F121, 7), "f_F121_nz", display = display.data_window)
plot(ex_F121 - ex_F121, "f_F121_sub", display = display.data_window)
