//@version=5
indicator("F052", overlay = false)
// F052 · synb and f_count() · dialects 5 · twin F053 · pin:W3-lazy-and-or · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
type Ctr_F052
    int n_F052 = 0
var Ctr_F052 k_F052 = Ctr_F052.new()
f_count_F052() =>
    var int c_F052 = 0
    c_F052 += 1
    k_F052.n_F052 := c_F052
    c_F052 > 0
v1_F052 = synb and f_count_F052()
plot(na(v1_F052) ? 1 : 0, "f_F052_isna", display = display.data_window)
plot(na(v1_F052) ? na : (v1_F052 ? 1 : 0), "f_F052_val", display = display.data_window)
plot(k_F052.n_F052, "f_F052_cnt", display = display.data_window)
