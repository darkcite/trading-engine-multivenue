//@version=6
indicator("F089", overlay = false)
// F089 · a history offset of 6000 from row 10 · dialects 56 · pin:03-hist-dynamic-offset · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
int k_F089 = _n > 10 ? 6000 : 1
e_F089 = syn[k_F089]
plot(na(e_F089) ? 1 : 0, "f_F089_isna", display = display.data_window)
plot(na(e_F089) ? na : e_F089, "f_F089_val", display = display.data_window)
