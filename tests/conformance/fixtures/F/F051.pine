//@version=6
indicator("F051", overlay = false)
// F051 · synb or rhs(k) · dialects 6 · twin F030 · pin:W3-lazy-and-or · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
type Ctr_F051
    int n_F051 = 0
var Ctr_F051 k_F051 = Ctr_F051.new()
rhs_F051(Ctr_F051 c_F051) =>
    c_F051.n_F051 := c_F051.n_F051 + 1
    ta.sma(syn, 5) > 0
v1_F051 = synb or rhs_F051(k_F051)
plot(v1_F051 ? 1 : 0, "f_F051_val", display = display.data_window)
plot(k_F051.n_F051, "f_F051_cnt", display = display.data_window)
