//@version=6
indicator("F122", overlay = false)
// F122 · float == and the ordering operators on series operands · dialects 56 · pin:U06-float-eq-v6 · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
a_F122  = syn + 5e-11
a2_F122 = syn + 2e-10
bg_F122 = syn * 1e7
plot(a_F122 == syn ? 1 : 0, "f_F122_eq", display = display.data_window)
plot(a_F122 != syn ? 1 : 0, "f_F122_ne", display = display.data_window)
plot(a_F122 > syn ? 1 : 0, "f_F122_gt", display = display.data_window)
plot(syn < a_F122 ? 1 : 0, "f_F122_lt", display = display.data_window)
plot(a_F122 >= syn and syn >= a_F122 ? 1 : 0, "f_F122_both", display = display.data_window)
plot(a2_F122 == syn ? 1 : 0, "f_F122_eq2", display = display.data_window)
plot(bg_F122 + 1e-4 == bg_F122 ? 1 : 0, "f_F122_big", display = display.data_window)
plot(a_F122 - syn, "f_F122_diff", display = display.data_window)
