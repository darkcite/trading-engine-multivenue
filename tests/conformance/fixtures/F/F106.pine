indicator("F106", overlay = false)
// F106 · binary_search, _leftmost, _rightmost on float and int, a value below the first element · dialects 56 · pin:04-binary-search · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
wf_F106 = array.from(10.0, 20.0, 30.0, 40.0)
wi_F106 = array.from(10, 20, 30, 40)
plot(array.binary_search(wf_F106, 20.0), "f_F106_f_plain20", display = display.data_window)
