indicator("F062", overlay = false)
// F062 · 0.1 + 0.2 == 0.3, 1.0000000001 == 1.0, 1e-10 == 2e-10 · dialects 6 · twin F061 · pin:U06-float-eq-v6 · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
