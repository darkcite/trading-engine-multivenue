//@version=6
indicator("F050", overlay = false)
// F050 · cnt · dialects 56 · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
int i_F050 = 1000 + (syni - syni)
int cnt_F050 = 0
while i_F050 > 0
    i_F050 := int(i_F050 / 2)
    cnt_F050 += 1
v1_F050 = cnt_F050
plot(na(v1_F050) ? 1 : 0, "f_F050_isna", display = display.data_window)
plot(na(v1_F050) ? na : v1_F050, "f_F050_val", display = display.data_window)
