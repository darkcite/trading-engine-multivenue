indicator("F074", overlay = false)
// F074 · PROJ of color.red, color.teal, color.yellow · dialects 6 · twin F073 · pin:00-color-consts · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
plot(color.r(color.red) * 65536 + color.g(color.red) * 256 + color.b(color.red), "f_F074_val1", display = display.data_window)
plot(color.r(color.teal) * 65536 + color.g(color.teal) * 256 + color.b(color.teal), "f_F074_val2", display = display.data_window)
plot(color.r(color.yellow) * 65536 + color.g(color.yellow) * 256 + color.b(color.yellow), "f_F074_val3", display = display.data_window)
