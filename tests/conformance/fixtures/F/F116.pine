//@version=6
indicator("F116", overlay = false)
// F116 · float % with a negative divisor, a negative dividend, both; no zero remainder · dialects 56 · pin:06-mod-sign · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
plot(na((syni + 0.25) % (0.0 - 2.5)) ? 1 : 0, "f_F116_isna1", display = display.data_window)
plot(na((syni + 0.25) % (0.0 - 2.5)) ? na : (syni + 0.25) % (0.0 - 2.5), "f_F116_val1", display = display.data_window)
plot(na((-0.25 - syni) % 2.5) ? 1 : 0, "f_F116_isna2", display = display.data_window)
plot(na((-0.25 - syni) % 2.5) ? na : (-0.25 - syni) % 2.5, "f_F116_val2", display = display.data_window)
plot(na((-0.25 - syni) % (0.0 - 2.5)) ? 1 : 0, "f_F116_isna3", display = display.data_window)
plot(na((-0.25 - syni) % (0.0 - 2.5)) ? na : (-0.25 - syni) % (0.0 - 2.5), "f_F116_val3", display = display.data_window)
plot(na((syni + 0.25) % 2.5) ? 1 : 0, "f_F116_isna4", display = display.data_window)
plot(na((syni + 0.25) % 2.5) ? na : (syni + 0.25) % 2.5, "f_F116_val4", display = display.data_window)
