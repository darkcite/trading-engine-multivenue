//@version=6
indicator("F080", overlay = false)
// F080 · color.t of #FF000080, #FF000040, #FF0000C0, #FF000001 · dialects 56 · pin:02-color-alpha · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
plot(na(color.t(#FF000080)) ? 1 : 0, "f_F080_isna1", display = display.data_window)
plot(na(color.t(#FF000080)) ? na : color.t(#FF000080), "f_F080_val1", display = display.data_window)
plot(na(color.t(#FF000040)) ? 1 : 0, "f_F080_isna2", display = display.data_window)
plot(na(color.t(#FF000040)) ? na : color.t(#FF000040), "f_F080_val2", display = display.data_window)
plot(na(color.t(#FF0000C0)) ? 1 : 0, "f_F080_isna3", display = display.data_window)
plot(na(color.t(#FF0000C0)) ? na : color.t(#FF0000C0), "f_F080_val3", display = display.data_window)
plot(na(color.t(#FF000001)) ? 1 : 0, "f_F080_isna4", display = display.data_window)
plot(na(color.t(#FF000001)) ? na : color.t(#FF000001), "f_F080_val4", display = display.data_window)
