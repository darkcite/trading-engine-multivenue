//@version=6
indicator("F120", overlay = false)
// F120 · series int beyond 2^53 and 2^63 · dialects 56 · pin:06-int-width · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
big_F120  = bar_index >= 0 ? 9007199254740992 : 0
odd_F120  = bar_index >= 0 ? 9007199254740993 : 0
imax_F120 = bar_index >= 0 ? 9223372036854775807 : 0
sq_F120   = bar_index >= 0 ? 3037000500 : 0
huge_F120 = bar_index >= 0 ? 1e30 : 0.0
b1_F120   = big_F120 + 1
plot(b1_F120 == big_F120 ? 1 : 0, "f_F120_eqadd", display = display.data_window)
plot(odd_F120 == big_F120 ? 1 : 0, "f_F120_eqlit", display = display.data_window)
plot(b1_F120 % 2, "f_F120_mod", display = display.data_window)
plot(imax_F120 + 1 > 0 ? 1 : 0, "f_F120_wrap", display = display.data_window)
plot((imax_F120 * 2) / imax_F120, "f_F120_mul", display = display.data_window)
plot(sq_F120 * sq_F120, "f_F120_sq", display = display.data_window)
plot(na(int(huge_F120)) ? 1 : 0, "f_F120_castna", display = display.data_window)
plot(int(huge_F120), "f_F120_cast", display = display.data_window)
plot(b1_F120 - big_F120, "f_F120_sub", display = display.data_window)
