indicator("F015", overlay = false)
// F015 · math.round(0.5), math.round(-0.5), math.round(1.5), math.round(-1.5), math.round(2.5), math.round(-2.5) · dialects 56 · pin:U04-round-ties · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
v1_F015 = math.round(0.5)
v2_F015 = math.round(-0.5)
v3_F015 = math.round(1.5)
v4_F015 = math.round(-1.5)
v5_F015 = math.round(2.5)
v6_F015 = math.round(-2.5)
plot(v1_F015, "f_F015_val1", display = display.data_window)
plot(v2_F015, "f_F015_val2", display = display.data_window)
plot(v3_F015, "f_F015_val3", display = display.data_window)
plot(v4_F015, "f_F015_val4", display = display.data_window)
plot(v5_F015, "f_F015_val5", display = display.data_window)
plot(v6_F015, "f_F015_val6", display = display.data_window)
