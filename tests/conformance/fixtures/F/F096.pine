//@version=6
indicator("F096", shorttitle = "s096", overlay = true, format = format.price, precision = 4, scale = scale.left, explicit_plot_zorder = true, max_lines_count = 10, max_labels_count = 10, max_boxes_count = 10, max_polylines_count = 10)
// F096 · ta.ema(syn, 5) under every inert indicator argument · dialects 56 · pin:10-shell-decl-args · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
e_F096 = ta.ema(syn, 5)
plot(na(e_F096) ? 1 : 0, "f_F096_isna", display = display.data_window)
plot(na(e_F096) ? na : e_F096, "f_F096_val", display = display.data_window)
