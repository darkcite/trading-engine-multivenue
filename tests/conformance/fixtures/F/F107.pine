indicator("F107", overlay = false)
// F107 · map: put get contains remove clear size keys values copy put_all · dialects 56 · pin:04-collection-edges · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
m_F107 = map.new<string, float>()
map.put(m_F107, "a", syn)
map.put(m_F107, "b", syn + 1.0)
old_F107 = map.put(m_F107, "a", syn + 2.0)
g_F107 = map.get(m_F107, "a")
h_F107 = map.contains(m_F107, "b")
x_F107 = map.get(m_F107, "zz")
rm_F107 = map.remove(m_F107, "b")
sz1_F107 = map.size(m_F107)
m2_F107 = map.copy(m_F107)
map.put(m2_F107, "c", 3.0)
szm2_F107 = map.size(m2_F107)
mm_F107 = map.new<string, float>()
map.put(mm_F107, "d", 4.0)
map.put_all(m_F107, mm_F107)
k_F107 = map.keys(m_F107)
v_F107 = map.values(m_F107)
map.clear(m2_F107)
plot(na(old_F107) ? 1 : 0, "f_F107_old_na", display = display.data_window)
plot(na(old_F107) ? na : old_F107, "f_F107_old", display = display.data_window)
plot(na(g_F107) ? 1 : 0, "f_F107_get_na", display = display.data_window)
plot(na(g_F107) ? na : g_F107, "f_F107_get", display = display.data_window)
plot(h_F107 ? 1 : 0, "f_F107_contains", display = display.data_window)
plot(na(x_F107) ? 1 : 0, "f_F107_missing_na", display = display.data_window)
plot(na(x_F107) ? na : x_F107, "f_F107_missing", display = display.data_window)
plot(na(rm_F107) ? 1 : 0, "f_F107_removed_na", display = display.data_window)
plot(na(rm_F107) ? na : rm_F107, "f_F107_removed", display = display.data_window)
plot(na(sz1_F107) ? 1 : 0, "f_F107_size1_na", display = display.data_window)
plot(na(sz1_F107) ? na : sz1_F107, "f_F107_size1", display = display.data_window)
plot(na(szm2_F107) ? 1 : 0, "f_F107_sz_copy_na", display = display.data_window)
plot(na(szm2_F107) ? na : szm2_F107, "f_F107_sz_copy", display = display.data_window)
plot(na(map.size(m_F107)) ? 1 : 0, "f_F107_size2_na", display = display.data_window)
plot(na(map.size(m_F107)) ? na : map.size(m_F107), "f_F107_size2", display = display.data_window)
plot(na(array.join(k_F107, ",")) ? 1 : 0, "f_F107_keys_na", display = display.data_window)
plot(na(array.join(k_F107, ",")) ? na : str.length(array.join(k_F107, ",")), "f_F107_keys", display = display.data_window)
plot(na(array.get(v_F107, 1)) ? 1 : 0, "f_F107_value1_na", display = display.data_window)
plot(na(array.get(v_F107, 1)) ? na : array.get(v_F107, 1), "f_F107_value1", display = display.data_window)
plot(na(map.size(m2_F107)) ? 1 : 0, "f_F107_sz_clear_na", display = display.data_window)
