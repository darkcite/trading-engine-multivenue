//@version=5
indicator("F030", overlay = false)
// F030 · synb or rhs(k) · dialects 5 · twin F051 · pin:W3-lazy-and-or · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
type Ctr_F030
    int n_F030 = 0
var Ctr_F030 k_F030 = Ctr_F030.new()
rhs_F030(Ctr_F030 c_F030) =>
    c_F030.n_F030 := c_F030.n_F030 + 1
    ta.sma(syn, 5) > 0
v1_F030 = synb or rhs_F030(k_F030)
plot(na(v1_F030) ? 1 : 0, "f_F030_isna", display = display.data_window)
plot(na(v1_F030) ? na : (v1_F030 ? 1 : 0), "f_F030_val", display = display.data_window)
plot(k_F030.n_F030, "f_F030_cnt", display = display.data_window)
