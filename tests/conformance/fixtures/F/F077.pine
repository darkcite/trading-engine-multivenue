//@version=5
indicator("F077", overlay = false)
// F077 · for bound reassigned inside the loop · dialects 5 · twin F078 · pin:00-for-bound · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
int hi_F077 = 3 + (syni - syni)
int cnt_F077 = 0
for i_F077 = 0 to hi_F077
    cnt_F077 += 1
    hi_F077 := 6
plot(cnt_F077, "f_F077_val", display = display.data_window)
