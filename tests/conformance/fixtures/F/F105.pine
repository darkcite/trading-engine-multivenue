//@version=6
indicator("F105", overlay = false)
// F105 · array.every and array.some, an empty array included · dialects 56 · pin:04-collection-edges · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
b1_F105 = array.from(synb, true)
b2_F105 = array.from(false, synb)
b3_F105 = array.new_bool(0)
plot(array.every(b1_F105) ? 1 : 0, "f_F105_every1", display = display.data_window)
plot(array.some(b2_F105) ? 1 : 0, "f_F105_some2", display = display.data_window)
plot(array.every(b3_F105) ? 1 : 0, "f_F105_every0", display = display.data_window)
plot(array.some(b3_F105) ? 1 : 0, "f_F105_some0", display = display.data_window)
