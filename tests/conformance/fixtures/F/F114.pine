//@version=6
indicator("F114", overlay = false)
// F114 · method form next to the function form, the same values · dialects 56 · pin:04-collection-edges · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
a_F114 = array.new_float(0)
a_F114.push(syn)
a_F114.push(syn - 1.0)
a_F114.unshift(syn + 2.0)
b_F114 = array.new_float(0)
array.push(b_F114, syn)
array.push(b_F114, syn - 1.0)
array.unshift(b_F114, syn + 2.0)
a_F114.sort()
array.sort(b_F114)
m_F114 = map.new<string, float>()
m_F114.put("k", syn)
n_F114 = map.new<string, float>()
map.put(n_F114, "k", syn)
plot(na(a_F114.get(0)) ? 1 : 0, "f_F114_m_get0_na", display = display.data_window)
plot(na(a_F114.get(0)) ? na : a_F114.get(0), "f_F114_m_get0", display = display.data_window)
plot(na(array.get(b_F114, 0)) ? 1 : 0, "f_F114_f_get0_na", display = display.data_window)
plot(na(array.get(b_F114, 0)) ? na : array.get(b_F114, 0), "f_F114_f_get0", display = display.data_window)
plot(na(a_F114.last()) ? 1 : 0, "f_F114_m_last_na", display = display.data_window)
plot(na(a_F114.last()) ? na : a_F114.last(), "f_F114_m_last", display = display.data_window)
plot(na(array.last(b_F114)) ? 1 : 0, "f_F114_f_last_na", display = display.data_window)
plot(na(array.last(b_F114)) ? na : array.last(b_F114), "f_F114_f_last", display = display.data_window)
plot(na(a_F114.size()) ? 1 : 0, "f_F114_m_size_na", display = display.data_window)
plot(na(a_F114.size()) ? na : a_F114.size(), "f_F114_m_size", display = display.data_window)
plot(na(array.size(b_F114)) ? 1 : 0, "f_F114_f_size_na", display = display.data_window)
plot(na(array.size(b_F114)) ? na : array.size(b_F114), "f_F114_f_size", display = display.data_window)
plot(na(m_F114.get("k")) ? 1 : 0, "f_F114_m_mget_na", display = display.data_window)
plot(na(m_F114.get("k")) ? na : m_F114.get("k"), "f_F114_m_mget", display = display.data_window)
plot(na(map.get(n_F114, "k")) ? 1 : 0, "f_F114_f_mget_na", display = display.data_window)
plot(na(map.get(n_F114, "k")) ? na : map.get(n_F114, "k"), "f_F114_f_mget", display = display.data_window)
