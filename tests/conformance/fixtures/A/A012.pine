//@version=6
indicator("A012", overlay = false)
// A012 · na through a user function · K12 × int · dialects 56 · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
int n_A012 = na
f_A012(int a_A012) => a_A012
e_A012 = f_A012(n_A012)
plot(na(e_A012) ? 1 : 0, "f_A012_isna", display = display.data_window)
plot(na(e_A012) ? na : e_A012, "f_A012_val", display = display.data_window)
