//@version=6
indicator("A027", overlay = false)
// A027 · na through four bars of history · K11 × float · dialects 56 · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
float n_A027 = na
float x_A027 = _n < 5 ? n_A027 : 7.5
e_A027 = x_A027[4]
plot(na(e_A027) ? 1 : 0, "f_A027_isna", display = display.data_window)
plot(na(e_A027) ? na : e_A027, "f_A027_val", display = display.data_window)
