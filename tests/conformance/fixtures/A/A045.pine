//@version=6
indicator("A045", overlay = false)
// A045 · na as a switch subject · K13 × color · dialects 56 · pin:04-color-edges · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
color n_A045 = na
e_A045 = switch n_A045
    color.rgb(1, 2, 3) => color.rgb(1, 2, 3)
    color.rgb(4, 5, 6) => color.rgb(1, 2, 3)
    => n_A045
plot(na(e_A045) ? 1 : 0, "f_A045_isna", display = display.data_window)
plot(na(e_A045) ? na : color.r(e_A045) * 65536 + color.g(e_A045) * 256 + color.b(e_A045), "f_A045_val", display = display.data_window)
