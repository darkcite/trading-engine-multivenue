//@version=6
indicator("A010", overlay = false)
// A010 · history on the first bar · K10 × int · dialects 56 · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
int n_A010 = na
int x_A010 = synb ? 7 : n_A010
e_A010 = x_A010[1]
plot(na(e_A010) ? 1 : 0, "f_A010_isna", display = display.data_window)
plot(na(e_A010) ? na : e_A010, "f_A010_val", display = display.data_window)
