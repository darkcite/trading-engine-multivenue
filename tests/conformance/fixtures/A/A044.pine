//@version=6
indicator("A044", overlay = false)
// A044 · na through a user function · K12 × color · dialects 56 · pin:04-color-edges · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
color n_A044 = na
f_A044(color a_A044) => a_A044
e_A044 = f_A044(n_A044)
plot(na(e_A044) ? 1 : 0, "f_A044_isna", display = display.data_window)
plot(na(e_A044) ? na : color.r(e_A044) * 65536 + color.g(e_A044) * 256 + color.b(e_A044), "f_A044_val", display = display.data_window)
