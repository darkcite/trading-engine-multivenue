//@version=6
indicator("A024", overlay = false)
// A024 · na() on a value · K08 × float · dialects 56 · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
float n_A024 = na
float x_A024 = 7.5
e_A024 = na(x_A024) ? n_A024 : x_A024
plot(na(e_A024) ? 1 : 0, "f_A024_isna", display = display.data_window)
plot(na(e_A024) ? na : e_A024, "f_A024_val", display = display.data_window)
