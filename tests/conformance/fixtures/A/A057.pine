//@version=6
indicator("A057", overlay = false)
// A057 · var across a conditional assignment · K09 × string · dialects 56 · pin:04-string-edges · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
string n_A057 = na
var string x_A057 = n_A057
if synb
    x_A057 := "ab"
e_A057 = x_A057
plot(na(e_A057) ? 1 : 0, "f_A057_isna", display = display.data_window)
plot(na(e_A057) ? na : str.length(e_A057), "f_A057_val", display = display.data_window)
