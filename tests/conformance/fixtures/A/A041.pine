//@version=6
indicator("A041", overlay = false)
// A041 · var across a conditional assignment · K09 × color · dialects 56 · pin:04-color-edges · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
color n_A041 = na
var color x_A041 = n_A041
if synb
    x_A041 := color.rgb(1, 2, 3)
e_A041 = x_A041
plot(na(e_A041) ? 1 : 0, "f_A041_isna", display = display.data_window)
plot(na(e_A041) ? na : color.r(e_A041) * 65536 + color.g(e_A041) * 256 + color.b(e_A041), "f_A041_val", display = display.data_window)
