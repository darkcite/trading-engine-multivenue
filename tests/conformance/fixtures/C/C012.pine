//@version=6
indicator("C012", overlay = false)
// C012 · var inside a function called from two sites · C-decl · dialects 56 · pin:06-cond-call-state · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
tick_C012() =>
    var int acc_C012 = 0
    acc_C012 := acc_C012 + 1
    acc_C012
a_C012 = tick_C012()
var int b_C012 = na
if synb
    b_C012 := tick_C012()
plot(a_C012, "f_C012_a", display = display.data_window)
plot(na(b_C012) ? 1 : 0, "f_C012_b_isna", display = display.data_window)
plot(na(b_C012) ? na : b_C012, "f_C012_b_val", display = display.data_window)
