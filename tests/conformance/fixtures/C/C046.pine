//@version=6
indicator("C046", overlay = false)
// C046 · once on the first realtime update · dialects 6 · pin:02-once-flag · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
varip int tl_C046 = 0
varip int upd_C046 = 0
varip int done_C046 = 0
if time != tl_C046
    tl_C046 := time
    upd_C046 := 0
    done_C046 := 0
upd_C046 += 1
if barstate.isconfirmed
    done_C046 := 1
varip int runs_C046 = 0
once barstate.isrealtime
    runs_C046 += 1
plot(barstate.isrealtime ? 1 : 0, "f_C046_rt", display = display.data_window)
plot(done_C046, "f_C046_done", display = display.data_window)
plot(runs_C046 == 1 ? 1 : 0, "f_C046_ok", display = display.data_window)
