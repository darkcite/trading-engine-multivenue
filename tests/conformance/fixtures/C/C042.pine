//@version=6
indicator("C042", overlay = false)
// C042 · a varip string survives the rollback · dialects 56 · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
varip int tl_C042 = 0
varip int upd_C042 = 0
varip int done_C042 = 0
if time != tl_C042
    tl_C042 := time
    upd_C042 := 0
    done_C042 := 0
upd_C042 += 1
if barstate.isconfirmed
    done_C042 := 1
varip string s_C042 = ""
if upd_C042 == 1
    s_C042 := ""
s_C042 += "x"
plot(barstate.isrealtime ? 1 : 0, "f_C042_rt", display = display.data_window)
plot(done_C042, "f_C042_done", display = display.data_window)
plot(upd_C042, "f_C042_upd", display = display.data_window)
plot(str.length(s_C042) >= 2 ? 1 : 0, "f_C042_ok", display = display.data_window)
