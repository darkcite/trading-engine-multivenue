//@version=6
indicator("C024", overlay = false)
// C024 · assignment copies the reference · dialects 56 · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
type Pt_C024
    int x_C024
var a_C024 = Pt_C024.new(0)
b_C024 = a_C024
b_C024.x_C024 := b_C024.x_C024 + 1
plot(na(a_C024.x_C024) ? 1 : 0, "f_C024_isna", display = display.data_window)
plot(na(a_C024.x_C024) ? na : a_C024.x_C024, "f_C024_val", display = display.data_window)
