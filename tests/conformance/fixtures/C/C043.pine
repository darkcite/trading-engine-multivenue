//@version=6
indicator("C043", overlay = false)
// C043 · a varip array · dialects 56 · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
varip int tl_C043 = 0
varip int upd_C043 = 0
varip int done_C043 = 0
if time != tl_C043
    tl_C043 := time
    upd_C043 := 0
    done_C043 := 0
upd_C043 += 1
if barstate.isconfirmed
    done_C043 := 1
varip a_C043 = array.new<float>()
plot(barstate.isrealtime ? 1 : 0, "f_C043_rt", display = display.data_window)
plot(done_C043, "f_C043_done", display = display.data_window)
plot(array.size(a_C043), "f_C043_val", display = display.data_window)
