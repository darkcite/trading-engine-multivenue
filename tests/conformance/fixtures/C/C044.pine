//@version=6
indicator("C044", overlay = false)
// C044 · barstate flags per realtime update, tick-independent · dialects 56 · pin:U17-barstate-table · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
varip int tl_C044 = 0
varip int upd_C044 = 0
varip int done_C044 = 0
if time != tl_C044
    tl_C044 := time
    upd_C044 := 0
    done_C044 := 0
upd_C044 += 1
if barstate.isconfirmed
    done_C044 := 1
varip int nw_C044 = 1
varip int cm_C044 = 1
varip int pc_C044 = 0
varip int bh_C044 = 0
varip int bl_C044 = 0
varip int br_C044 = 0
if upd_C044 == 1
    nw_C044 := 1
    cm_C044 := 1
    pc_C044 := 0
    bh_C044 := 0
    bl_C044 := 0
    br_C044 := 0
if barstate.isnew != (upd_C044 == 1)
    nw_C044 := 0
if pc_C044 == 1 and not barstate.isconfirmed
    cm_C044 := 0
if barstate.isconfirmed
    pc_C044 := 1
bh_C044 += barstate.ishistory ? 1 : 0
bl_C044 += not barstate.islast ? 1 : 0
br_C044 += not barstate.isrealtime ? 1 : 0
plot(barstate.isrealtime ? 1 : 0, "f_C044_rt", display = display.data_window)
plot(done_C044, "f_C044_done", display = display.data_window)
plot(nw_C044, "f_C044_isnew", display = display.data_window)
plot(barstate.isconfirmed ? 1 : 0, "f_C044_confirmed", display = display.data_window)
plot(cm_C044, "f_C044_confmono", display = display.data_window)
plot(bh_C044, "f_C044_ishistory", display = display.data_window)
plot(bl_C044, "f_C044_notlast", display = display.data_window)
plot(br_C044, "f_C044_notrt", display = display.data_window)
