//@version=6
indicator("C041", overlay = false)
// C041 · the varip update counter inside a function · dialects 56 · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
varip int tl_C041 = 0
varip int upd_C041 = 0
varip int done_C041 = 0
if time != tl_C041
    tl_C041 := time
    upd_C041 := 0
    done_C041 := 0
upd_C041 += 1
if barstate.isconfirmed
    done_C041 := 1
cnt_C041() =>
    varip int u_C041 = 0
    varip int t_C041 = 0
    if time != t_C041
        t_C041 := time
        u_C041 := 0
    u_C041 += 1
    u_C041
fu_C041 = cnt_C041()
var int v_C041 = 0
v_C041 += 1
plot(barstate.isrealtime ? 1 : 0, "f_C041_rt", display = display.data_window)
plot(done_C041, "f_C041_done", display = display.data_window)
plot(fu_C041, "f_C041_upd", display = display.data_window)
plot(v_C041 - nz(v_C041[1]) == 1 and fu_C041 >= 2 ? 1 : 0, "f_C041_ok", display = display.data_window)
