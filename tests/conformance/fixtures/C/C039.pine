//@version=6
indicator("C039", overlay = false)
// C039 · a var advances once per realtime bar · dialects 56 · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
varip int tl_C039 = 0
varip int upd_C039 = 0
varip int done_C039 = 0
if time != tl_C039
    tl_C039 := time
    upd_C039 := 0
    done_C039 := 0
upd_C039 += 1
if barstate.isconfirmed
    done_C039 := 1
var int v_C039 = 0
v_C039 += 1
plot(barstate.isrealtime ? 1 : 0, "f_C039_rt", display = display.data_window)
plot(done_C039, "f_C039_done", display = display.data_window)
plot(v_C039 - nz(v_C039[1]), "f_C039_val", display = display.data_window)
