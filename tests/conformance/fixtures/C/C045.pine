//@version=6
indicator("C045", overlay = false)
// C045 · the barstate flags on history rows and an open bar · dialects 56 · pin:U17-barstate-table · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
plot(barstate.isconfirmed ? 1 : 0, "f_C045_isconfirmed", display = display.data_window)
plot(barstate.islast ? 1 : 0, "f_C045_islast", display = display.data_window)
plot(barstate.isnew ? 1 : 0, "f_C045_isnew", display = display.data_window)
plot(barstate.isrealtime ? 1 : 0, "f_C045_isrealtime", display = display.data_window)
plot(barstate.ishistory ? 1 : 0, "f_C045_ishistory", display = display.data_window)
plot(barstate.isfirst ? 1 : 0, "f_C045_isfirst", display = display.data_window)
plot(barstate.islastconfirmedhistory ? 1 : 0, "f_C045_islch", display = display.data_window)
