//@version=6
indicator("D001", overlay = false)
// D001 · 240 close, gaps off, lookahead off · D-matrix · dialects 56 · generated by pine-conf gen; do not edit
h_D001 = request.security(syminfo.tickerid, "240", close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
plot(na(h_D001) ? 1 : 0, "f_D001_isna", display = display.data_window)
plot(na(h_D001) ? na : h_D001, "f_D001_val", display = display.data_window)
