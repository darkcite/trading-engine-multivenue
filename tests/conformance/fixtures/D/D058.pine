//@version=6
indicator("D058", overlay = false)
// D058 · the exchange time zone and the trading day · D-tz · dialects 56 · pin:04-exchange-tz · generated by pine-conf gen; do not edit
plot(syminfo.timezone == "Etc/UTC" ? 1 : 0, "f_D058_val1", display = display.data_window)
plot((time - time_tradingday) / 3600000, "f_D058_val2", display = display.data_window)
plot(session.isfirstbar ? 1 : 0, "f_D058_val3", display = display.data_window)
plot(session.islastbar ? 1 : 0, "f_D058_val4", display = display.data_window)
