//@version=6
indicator("D010", overlay = false)
// D010 · D ta.sma(close, 5), gaps off, lookahead off · D-matrix · dialects 56 · generated by pine-conf gen; do not edit
h_D010 = request.security(syminfo.tickerid, "D", ta.sma(close, 5), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
plot(na(h_D010) ? 1 : 0, "f_D010_isna", display = display.data_window)
plot(na(h_D010) ? na : h_D010, "f_D010_val", display = display.data_window)
