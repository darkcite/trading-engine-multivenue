//@version=6
indicator("D048", overlay = false)
// D048 · an unmapped ticker, ignore_invalid_symbol = true · D-symbol · dialects 56 · generated by pine-conf gen; do not edit
h_D048 = request.security("NASDAQ:AAPL", "60", close, ignore_invalid_symbol = true)
plot(na(h_D048) ? 1 : 0, "f_D048_isna", display = display.data_window)
plot(na(h_D048) ? na : h_D048, "f_D048_val", display = display.data_window)
