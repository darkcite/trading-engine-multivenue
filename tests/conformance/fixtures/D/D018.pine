//@version=6
indicator("D018", overlay = false)
// D018 · D close[1] with lookahead on · D-leakfree · dialects 56 · generated by pine-conf gen; do not edit
h_D018 = request.security(syminfo.tickerid, "D", close[1], lookahead = barmerge.lookahead_on)
plot(na(h_D018) ? 1 : 0, "f_D018_isna", display = display.data_window)
plot(na(h_D018) ? na : h_D018, "f_D018_val", display = display.data_window)
