indicator("D017", overlay = false)
// D017 · 240 close[1] with lookahead on · D-leakfree · dialects 56 · generated by pine-conf gen; do not edit
h_D017 = request.security(syminfo.tickerid, "240", close[1], lookahead = barmerge.lookahead_on)
plot(na(h_D017) ? 1 : 0, "f_D017_isna", display = display.data_window)
plot(na(h_D017) ? na : h_D017, "f_D017_val", display = display.data_window)
