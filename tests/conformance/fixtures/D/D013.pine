//@version=6
indicator("D013", overlay = false)
// D013 · D close, gaps on, lookahead off · D-matrix · dialects 56 · generated by pine-conf gen; do not edit
h_D013 = request.security(syminfo.tickerid, "D", close, gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_off)
plot(na(h_D013) ? 1 : 0, "f_D013_isna", display = display.data_window)
plot(na(h_D013) ? na : h_D013, "f_D013_val", display = display.data_window)
