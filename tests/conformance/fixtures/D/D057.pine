//@version=6
indicator("D057", overlay = false)
// D057 · a five-range session string · D-time · dialects 56 · pin:04-time-edges · generated by pine-conf gen; do not edit
t_D057 = time("60", "0000-0100,0200-0300,0400-0500,0600-0700,0800-0900")
plot(na(t_D057) ? 1 : 0, "f_D057_isna", display = display.data_window)
