//@version=6
indicator("D044", overlay = false)
// D044 · D value and time, gaps on · D-boundary · dialects 56 · generated by pine-conf gen; do not edit
h_D044 = request.security(syminfo.tickerid, "D", close, gaps = barmerge.gaps_on)
t_D044 = request.security(syminfo.tickerid, "D", time, gaps = barmerge.gaps_on)
plot(na(h_D044) ? 1 : 0, "f_D044_isna1", display = display.data_window)
plot(na(h_D044) ? na : h_D044, "f_D044_val1", display = display.data_window)
plot(na(t_D044) ? 1 : 0, "f_D044_isna2", display = display.data_window)
plot(na(t_D044) ? na : t_D044, "f_D044_val2", display = display.data_window)
