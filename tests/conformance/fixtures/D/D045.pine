indicator("D045", overlay = false)
// D045 · W time, the Monday anchor · D-boundary · dialects 56 · generated by pine-conf gen; do not edit
t_D045 = request.security(syminfo.tickerid, "W", time)
plot(na(t_D045) ? 1 : 0, "f_D045_isna", display = display.data_window)
plot(na(t_D045) ? na : t_D045, "f_D045_val", display = display.data_window)
