//@version=6
indicator("D053", overlay = false)
// D053 · the 5-minute value against close, tick-independent · D-rt · dialects 56 · pin:U12-lookahead-off-realtime · generated by pine-conf gen; do not edit
varip int tl_D053 = 0
varip int upd_D053 = 0
varip int done_D053 = 0
varip int k_D053 = 0
if time != tl_D053
    tl_D053 := time
    upd_D053 := 0
    done_D053 := 0
    k_D053 := 0
upd_D053 += 1
if barstate.isconfirmed
    done_D053 := 1
h_D053 = request.security(syminfo.tickerid, "5", close)
k_D053 += h_D053 != close ? 1 : 0
varip int sn_D053 = 0
if upd_D053 == 1
    sn_D053 := 0
if h_D053 == close
    sn_D053 := 1
c5_D053 = time % 300000 == 240000
plot(barstate.isrealtime ? 1 : 0, "f_D053_rt", display = display.data_window)
plot(done_D053, "f_D053_done", display = display.data_window)
plot(k_D053, "f_D053_k", display = display.data_window)
plot(c5_D053 ? (h_D053 == close ? 1 : 0) : 1, "f_D053_eqc", display = display.data_window)
plot(c5_D053 ? 1 : sn_D053, "f_D053_dev", display = display.data_window)
