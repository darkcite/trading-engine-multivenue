//@version=6
indicator("D043", overlay = false)
// D043 · D value and time, gaps off · D-boundary · dialects 56 · generated by pine-conf gen; do not edit
h_D043 = request.security(syminfo.tickerid, "D", close, gaps = barmerge.gaps_off)
t_D043 = request.security(syminfo.tickerid, "D", time, gaps = barmerge.gaps_off)
plot(na(h_D043) ? 1 : 0, "f_D043_isna1", display = display.data_window)
plot(na(h_D043) ? na : h_D043, "f_D043_val1", display = display.data_window)
plot(na(t_D043) ? 1 : 0, "f_D043_isna2", display = display.data_window)
plot(na(t_D043) ? na : t_D043, "f_D043_val2", display = display.data_window)
