//@version=6
indicator("D054", overlay = false)
// D054 · the 5-minute value with gaps on, tick-independent · D-rt · dialects 56 · pin:U12-lookahead-off-realtime · generated by pine-conf gen; do not edit
varip int tl_D054 = 0
varip int upd_D054 = 0
varip int done_D054 = 0
varip int k_D054 = 0
if time != tl_D054
    tl_D054 := time
    upd_D054 := 0
    done_D054 := 0
    k_D054 := 0
upd_D054 += 1
if barstate.isconfirmed
    done_D054 := 1
h_D054 = request.security(syminfo.tickerid, "5", close, gaps = barmerge.gaps_on)
k_D054 += na(h_D054) ? 1 : 0
var int nb_D054 = 0
var bool full_D054 = false
if time % 300000 == 0
    nb_D054 := 0
    full_D054 := barstate.isrealtime
if not na(h_D054)
    nb_D054 += 1
plot(barstate.isrealtime ? 1 : 0, "f_D054_rt", display = display.data_window)
plot(done_D054, "f_D054_done", display = display.data_window)
plot(k_D054, "f_D054_k", display = display.data_window)
plot(k_D054 == 0 or k_D054 == upd_D054 ? 1 : 0, "f_D054_uni", display = display.data_window)
plot(time % 300000 == 240000 and full_D054 ? (nb_D054 == 1 ? 1 : 0) : 1, "f_D054_one", display = display.data_window)
