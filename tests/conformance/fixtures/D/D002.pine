//@version=6
indicator("D002", overlay = false)
// D002 · 240 ta.sma(close, 5), gaps off, lookahead off · D-matrix · dialects 56 · generated by pine-conf gen; do not edit
h_D002 = request.security(syminfo.tickerid, "240", ta.sma(close, 5), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
plot(na(h_D002) ? 1 : 0, "f_D002_isna", display = display.data_window)
plot(na(h_D002) ? na : h_D002, "f_D002_val", display = display.data_window)
