//@version=6
indicator("D026", overlay = false)
// D026 · a tuple [close, open] at 240 · D-expr · dialects 56 · generated by pine-conf gen; do not edit
[c_D026, o_D026] = request.security(syminfo.tickerid, "240", [close, open])
plot(na(c_D026) ? 1 : 0, "f_D026_isna1", display = display.data_window)
plot(na(c_D026) ? na : c_D026, "f_D026_val1", display = display.data_window)
plot(na(o_D026) ? 1 : 0, "f_D026_isna2", display = display.data_window)
plot(na(o_D026) ? na : o_D026, "f_D026_val2", display = display.data_window)
