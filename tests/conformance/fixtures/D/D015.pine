//@version=6
indicator("D015", overlay = false)
// D015 · D close, gaps on, lookahead on · D-matrix · dialects 56 · generated by pine-conf gen; do not edit
h_D015 = request.security(syminfo.tickerid, "D", close, gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_on)
plot(na(h_D015) ? 1 : 0, "f_D015_isna", display = display.data_window)
plot(na(h_D015) ? na : h_D015, "f_D015_val", display = display.data_window)
