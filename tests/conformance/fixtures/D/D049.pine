//@version=6
indicator("D049", overlay = false)
// D049 · an unmapped ticker, ignore_invalid_symbol = false · D-symbol · dialects 56 · generated by pine-conf gen; do not edit
h_D049 = request.security("NASDAQ:AAPL", "60", close, ignore_invalid_symbol = false)
plot(na(h_D049) ? 1 : 0, "f_D049_isna", display = display.data_window)
plot(na(h_D049) ? na : h_D049, "f_D049_val", display = display.data_window)
