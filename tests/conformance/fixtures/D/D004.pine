//@version=6
indicator("D004", overlay = false)
// D004 · 240 ta.sma(close, 5), gaps off, lookahead on · D-matrix · dialects 56 · generated by pine-conf gen; do not edit
h_D004 = request.security(syminfo.tickerid, "240", ta.sma(close, 5), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
plot(na(h_D004) ? 1 : 0, "f_D004_isna", display = display.data_window)
plot(na(h_D004) ? na : h_D004, "f_D004_val", display = display.data_window)
