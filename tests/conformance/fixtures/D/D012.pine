//@version=6
indicator("D012", overlay = false)
// D012 · D ta.sma(close, 5), gaps off, lookahead on · D-matrix · dialects 56 · generated by pine-conf gen; do not edit
h_D012 = request.security(syminfo.tickerid, "D", ta.sma(close, 5), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
plot(na(h_D012) ? 1 : 0, "f_D012_isna", display = display.data_window)
plot(na(h_D012) ? na : h_D012, "f_D012_val", display = display.data_window)
