//@version=6
indicator("D016", overlay = false)
// D016 · D ta.sma(close, 5), gaps on, lookahead on · D-matrix · dialects 56 · generated by pine-conf gen; do not edit
h_D016 = request.security(syminfo.tickerid, "D", ta.sma(close, 5), gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_on)
plot(na(h_D016) ? 1 : 0, "f_D016_isna", display = display.data_window)
plot(na(h_D016) ? na : h_D016, "f_D016_val", display = display.data_window)
