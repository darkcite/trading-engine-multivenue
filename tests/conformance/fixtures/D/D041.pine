//@version=6
indicator("D041", overlay = false)
// D041 · 240 value and time, gaps off · D-boundary · dialects 56 · generated by pine-conf gen; do not edit
h_D041 = request.security(syminfo.tickerid, "240", close, gaps = barmerge.gaps_off)
t_D041 = request.security(syminfo.tickerid, "240", time, gaps = barmerge.gaps_off)
plot(na(h_D041) ? 1 : 0, "f_D041_isna1", display = display.data_window)
plot(na(h_D041) ? na : h_D041, "f_D041_val1", display = display.data_window)
plot(na(t_D041) ? 1 : 0, "f_D041_isna2", display = display.data_window)
plot(na(t_D041) ? na : t_D041, "f_D041_val2", display = display.data_window)
