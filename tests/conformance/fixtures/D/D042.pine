//@version=6
indicator("D042", overlay = false)
// D042 · 240 value and time, gaps on · D-boundary · dialects 56 · generated by pine-conf gen; do not edit
h_D042 = request.security(syminfo.tickerid, "240", close, gaps = barmerge.gaps_on)
t_D042 = request.security(syminfo.tickerid, "240", time, gaps = barmerge.gaps_on)
plot(na(h_D042) ? 1 : 0, "f_D042_isna1", display = display.data_window)
plot(na(h_D042) ? na : h_D042, "f_D042_val1", display = display.data_window)
plot(na(t_D042) ? 1 : 0, "f_D042_isna2", display = display.data_window)
plot(na(t_D042) ? na : t_D042, "f_D042_val2", display = display.data_window)
