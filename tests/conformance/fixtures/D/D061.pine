//@version=6
indicator("D061", overlay = false)
// D061 · a currency-converted request · D-fx · dialects 56 · generated by pine-conf gen; do not edit
h_D061 = request.security(syminfo.tickerid, "240", close, currency = currency.EUR)
plot(na(h_D061) ? 1 : 0, "f_D061_isna", display = display.data_window)
plot(na(h_D061) ? na : h_D061, "f_D061_val", display = display.data_window)
