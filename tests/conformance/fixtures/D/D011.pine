//@version=6
indicator("D011", overlay = false)
// D011 · D close, gaps off, lookahead on · D-matrix · dialects 56 · generated by pine-conf gen; do not edit
h_D011 = request.security(syminfo.tickerid, "D", close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
plot(na(h_D011) ? 1 : 0, "f_D011_isna", display = display.data_window)
plot(na(h_D011) ? na : h_D011, "f_D011_val", display = display.data_window)
