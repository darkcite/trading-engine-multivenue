//@version=6
indicator("D003", overlay = false)
// D003 · 240 close, gaps off, lookahead on · D-matrix · dialects 56 · generated by pine-conf gen; do not edit
h_D003 = request.security(syminfo.tickerid, "240", close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
plot(na(h_D003) ? 1 : 0, "f_D003_isna", display = display.data_window)
plot(na(h_D003) ? na : h_D003, "f_D003_val", display = display.data_window)
