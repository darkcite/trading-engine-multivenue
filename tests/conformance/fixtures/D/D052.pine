indicator("D052", overlay = false)
// D052 · an unoffset lookahead_on compiled live-bound · D-refuse · dialects 6 · twin D051 · generated by pine-conf gen; do not edit
h_D052 = request.security(syminfo.tickerid, "240", close, lookahead = barmerge.lookahead_on)
plot(na(h_D052) ? 1 : 0, "f_D052_isna", display = display.data_window)
plot(na(h_D052) ? na : h_D052, "f_D052_val", display = display.data_window)
