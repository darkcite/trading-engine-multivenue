//@version=6
indicator("D005", overlay = false)
// D005 · 240 close, gaps on, lookahead off · D-matrix · dialects 56 · generated by pine-conf gen; do not edit
h_D005 = request.security(syminfo.tickerid, "240", close, gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_off)
plot(na(h_D005) ? 1 : 0, "f_D005_isna", display = display.data_window)
plot(na(h_D005) ? na : h_D005, "f_D005_val", display = display.data_window)
