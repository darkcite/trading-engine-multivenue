//@version=6
indicator("D006", overlay = false)
// D006 · 240 ta.sma(close, 5), gaps on, lookahead off · D-matrix · dialects 56 · generated by pine-conf gen; do not edit
h_D006 = request.security(syminfo.tickerid, "240", ta.sma(close, 5), gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_off)
plot(na(h_D006) ? 1 : 0, "f_D006_isna", display = display.data_window)
plot(na(h_D006) ? na : h_D006, "f_D006_val", display = display.data_window)
