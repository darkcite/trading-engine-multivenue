//@version=5
indicator("D051", overlay = false)
// D051 · an unoffset lookahead_on compiled live-bound · D-refuse · dialects 5 · twin D052 · generated by pine-conf gen; do not edit
h_D051 = request.security(syminfo.tickerid, "240", close, lookahead = barmerge.lookahead_on)
plot(na(h_D051) ? 1 : 0, "f_D051_isna", display = display.data_window)
plot(na(h_D051) ? na : h_D051, "f_D051_val", display = display.data_window)
