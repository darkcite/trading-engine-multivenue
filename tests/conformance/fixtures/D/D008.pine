//@version=6
indicator("D008", overlay = false)
// D008 · 240 ta.sma(close, 5), gaps on, lookahead on · D-matrix · dialects 56 · generated by pine-conf gen; do not edit
h_D008 = request.security(syminfo.tickerid, "240", ta.sma(close, 5), gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_on)
plot(na(h_D008) ? 1 : 0, "f_D008_isna", display = display.data_window)
plot(na(h_D008) ? na : h_D008, "f_D008_val", display = display.data_window)
