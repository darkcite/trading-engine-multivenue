indicator("D062", overlay = false)
// D062 · request.currency_rate · D-fx · dialects 56 · generated by pine-conf gen; do not edit
h_D062 = request.currency_rate(currency.USD, currency.EUR)
plot(na(h_D062) ? 1 : 0, "f_D062_isna", display = display.data_window)
plot(na(h_D062) ? na : h_D062, "f_D062_val", display = display.data_window)
