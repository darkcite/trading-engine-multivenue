//@version=6
indicator("D009", overlay = false)
// D009 · D close, gaps off, lookahead off · D-matrix · dialects 56 · generated by pine-conf gen; do not edit
h_D009 = request.security(syminfo.tickerid, "D", close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
plot(na(h_D009) ? 1 : 0, "f_D009_isna", display = display.data_window)
plot(na(h_D009) ? na : h_D009, "f_D009_val", display = display.data_window)
