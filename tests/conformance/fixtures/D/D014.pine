indicator("D014", overlay = false)
// D014 · D ta.sma(close, 5), gaps on, lookahead off · D-matrix · dialects 56 · generated by pine-conf gen; do not edit
h_D014 = request.security(syminfo.tickerid, "D", ta.sma(close, 5), gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_off)
plot(na(h_D014) ? 1 : 0, "f_D014_isna", display = display.data_window)
plot(na(h_D014) ? na : h_D014, "f_D014_val", display = display.data_window)
