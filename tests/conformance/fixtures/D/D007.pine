//@version=6
indicator("D007", overlay = false)
// D007 · 240 close, gaps on, lookahead on · D-matrix · dialects 56 · generated by pine-conf gen; do not edit
h_D007 = request.security(syminfo.tickerid, "240", close, gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_on)
plot(na(h_D007) ? 1 : 0, "f_D007_isna", display = display.data_window)
plot(na(h_D007) ? na : h_D007, "f_D007_val", display = display.data_window)
