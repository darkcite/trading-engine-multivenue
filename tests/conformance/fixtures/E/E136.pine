//@version=5
strategy("E136", overlay = false, initial_capital = 1000000,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 250, pyramiding = 1,
     commission_type = strategy.commission.percent, commission_value = 0, slippage = 0,
     margin_long = 100, margin_short = 100, process_orders_on_close = false,
     calc_on_order_fills = false, calc_on_every_tick = false, use_bar_magnifier = false)
// E136 · margin 100, 250 % of equity · E-margin · dialects 5 · pin:W18-margin-default · pin:05-margin-funds-check · generated by pine-conf gen; do not edit
// --- SYN-T --- generated; do not edit. SYN-1, advanced only inside the chart window.
var float _s = 1.0
var int   _n = 0
_on   = time >= 1776297600000 and time < 1791842400000
_last = time == 1791842400000
if _on
    _n := _n + 1
    _hi = math.floor(_s / 127773.0)
    _lo = _s - _hi * 127773.0
    _t  = 16807.0 * _lo - 2836.0 * _hi
    _s := _t > 0.0 ? _t : _t + 2147483647.0
syni = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb = syni >= 500
if _on and syni < 20 and strategy.position_size == 0
    strategy.entry("L1", strategy.long)
if _on and syni > 980 and strategy.position_size > 0
    strategy.close("L1")
if _last
    strategy.cancel_all()
    strategy.close_all()
plot(strategy.position_size, "f_E136_pos", display = display.data_window)
plot(strategy.margin_liquidation_price, "f_E136_liq", display = display.data_window)
