//@version=6
strategy("E126", overlay = false, initial_capital = 1000000,
     default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 1,
     commission_type = strategy.commission.percent, commission_value = 0, slippage = 0,
     margin_long = 0, margin_short = 0, process_orders_on_close = false,
     calc_on_order_fills = true, calc_on_every_tick = false, use_bar_magnifier = false,
     calc_on_every_history_tick = true)
// E126 · history ticks with calc_on_order_fills · E-hist · dialects 6 · pin:05-hist-tick-cof · generated by pine-conf gen; do not edit
// --- SYN-T --- generated; do not edit. SYN-1, advanced only inside the chart window.
var float _s = 1.0
var int   _n = 0
_on   = time >= 1776297600000 and time < 1791842400000
_last = time == 1791842400000
if _on
    _n := _n + 1
    _hi = math.floor(_s / 127773.0)
    _lo = _s - _hi * 127773.0
    _t  = 16807.0 * _lo - 2836.0 * _hi
    _s := _t > 0.0 ? _t : _t + 2147483647.0
syni = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb = syni >= 500
varip int k_E126 = 0
varip int tl_E126 = 0
if time != tl_E126
    tl_E126 := time
    k_E126 := 0
k_E126 := k_E126 + 1
varip float c1_E126 = na
if k_E126 == 1
    c1_E126 := close
if _on and syni < 20 and strategy.position_size == 0 and barstate.isconfirmed
    strategy.entry("L1", strategy.long)
if _on and syni > 980 and strategy.position_size > 0 and barstate.isconfirmed
    strategy.close("L1")
if _last
    strategy.cancel_all()
    strategy.close_all()
plot(strategy.position_size, "f_E126_pos", display = display.data_window)
plot(k_E126, "f_E126_runs", display = display.data_window)
plot(c1_E126 == close ? 1 : 0, "f_E126_first", display = display.data_window)
