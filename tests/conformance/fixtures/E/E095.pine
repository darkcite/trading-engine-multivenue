//@version=6
strategy("E095", overlay = false, initial_capital = 1000000,
     default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 1,
     commission_type = strategy.commission.percent, commission_value = 0, slippage = 0,
     margin_long = 0, margin_short = 0, process_orders_on_close = false,
     calc_on_order_fills = false, calc_on_every_tick = false, use_bar_magnifier = false)
// E095 · strategy.risk.allow_entry_in · E-risk · dialects 56 · pin:U10-risk-rules · generated by pine-conf gen; do not edit
// --- SYN-T --- generated; do not edit. SYN-1, advanced only inside the chart window.
var float _s = 1.0
var int   _n = 0
_on   = time >= 1776297600000 and time < 1791842400000
_last = time == 1791842400000
if _on
    _n := _n + 1
    _hi = math.floor(_s / 127773.0)
    _lo = _s - _hi * 127773.0
    _t  = 16807.0 * _lo - 2836.0 * _hi
    _s := _t > 0.0 ? _t : _t + 2147483647.0
syni = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb = syni >= 500
strategy.risk.allow_entry_in(strategy.direction.long)
if _on and syni < 10
    strategy.entry("L1", strategy.long)
if _on and syni > 989
    strategy.entry("S1", strategy.short)
if _last
    strategy.cancel_all()
    strategy.close_all()
plot(strategy.position_size, "f_E095_pos", display = display.data_window)
