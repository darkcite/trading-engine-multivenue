//@version=6
strategy("E122", overlay = false, initial_capital = 1000000,
     default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 1,
     commission_type = strategy.commission.percent, commission_value = 0, slippage = 0,
     margin_long = 0, margin_short = 0, process_orders_on_close = false,
     calc_on_order_fills = false, calc_on_every_tick = false, use_bar_magnifier = false,
     calc_on_every_history_tick = true)
// E122 · executions per history bar under calc_on_every_history_tick · E-hist · dialects 6 · pin:05-hist-tick-runs · generated by pine-conf gen; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
varip int k_E122 = 0
varip int nl_E122 = 0
varip int cf_E122 = 0
varip int tn_E122 = 0
if _n != nl_E122
    nl_E122 := _n
    k_E122 := 0
    cf_E122 := 0
    tn_E122 := 0
k_E122 := k_E122 + 1
if barstate.isconfirmed
    cf_E122 := cf_E122 + 1
if barstate.isnew and not barstate.isconfirmed
    tn_E122 := tn_E122 + 1
plot(k_E122, "f_E122_runs", display = display.data_window)
plot(cf_E122, "f_E122_conf", display = display.data_window)
