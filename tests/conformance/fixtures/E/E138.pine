//@version=6
strategy("E138", overlay = false, initial_capital = 1000000,
     default_qty_type = strategy.fixed, default_qty_value = 2, pyramiding = 2,
     commission_type = strategy.commission.percent, commission_value = 0, slippage = 0,
     margin_long = 0, margin_short = 0, process_orders_on_close = false,
     calc_on_order_fills = false, calc_on_every_tick = false, use_bar_magnifier = false)
// E138 · an exit qty over two trades, legs one tick away · E-pin5 · dialects 56 · pin:05-exit-qty-per-trade · generated by pine-conf gen; do not edit
// --- SYN-T --- generated; do not edit. SYN-1, advanced only inside the chart window.
var float _s = 1.0
var int   _n = 0
_on   = time >= 1776297600000 and time < 1791842400000
_last = time == 1791842400000
if _on
    _n := _n + 1
    _hi = math.floor(_s / 127773.0)
    _lo = _s - _hi * 127773.0
    _t  = 16807.0 * _lo - 2836.0 * _hi
    _s := _t > 0.0 ? _t : _t + 2147483647.0
syni = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb = syni >= 500
if _on and (_n == 1 or _n == 2)
    strategy.entry("L", strategy.long)
if _on and _n >= 3 and strategy.position_size > 0
    strategy.exit("X", "L", qty = 1, profit = 1, loss = 100000)
if _last
    strategy.cancel_all()
    strategy.close_all()
plot(strategy.position_size, "f_E138_pos", display = display.data_window)
plot(strategy.opentrades, "f_E138_ot", display = display.data_window)
plot(strategy.closedtrades, "f_E138_ct", display = display.data_window)
plot(strategy.opentrades > 0 ? strategy.opentrades.size(0) : na, "f_E138_s0", display = display.data_window)
plot(strategy.opentrades > 1 ? strategy.opentrades.size(1) : na, "f_E138_s1", display = display.data_window)
plot(strategy.opentrades > 1 ? strategy.opentrades.entry_bar_index(1) : na, "f_E138_b1", display = display.data_window)
