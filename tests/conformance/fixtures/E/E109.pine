//@version=6
strategy("E109", overlay = false, initial_capital = 1000000,
     default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 1,
     commission_type = strategy.commission.percent, commission_value = 0, slippage = 0,
     margin_long = 0, margin_short = 0, process_orders_on_close = false,
     calc_on_order_fills = false, calc_on_every_tick = false, use_bar_magnifier = false)
// E109 · two orders per trade, every step · E-limit · dialects 6 · pin:05-trade-trim · generated by pine-conf gen; do not edit
var bool t_E109 = false
t_E109 := not t_E109
if t_E109
    strategy.entry("L", strategy.long)
else
    strategy.close("L")
plot(strategy.closedtrades, "f_E109_closed", display = display.data_window)
plot(strategy.closedtrades.first_index, "f_E109_first", display = display.data_window)
plot(na(strategy.closedtrades.entry_bar_index(0)) ? 1 : 0, "f_E109_isna0", display = display.data_window)
