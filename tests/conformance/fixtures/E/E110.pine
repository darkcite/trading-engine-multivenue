//@version=5
strategy("E110", overlay = false, initial_capital = 1000000,
     default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 1,
     commission_type = strategy.commission.percent, commission_value = 0, slippage = 0,
     margin_long = 0, margin_short = 0, process_orders_on_close = false,
     calc_on_order_fills = false, calc_on_every_tick = false, use_bar_magnifier = false)
// E110 · two orders per trade, every step · E-limit · dialects 5 · pin:05-v5-order-limit · generated by pine-conf gen; do not edit
var bool t_E110 = false
t_E110 := not t_E110
if t_E110
    strategy.entry("L", strategy.long)
else
    strategy.close("L")
plot(strategy.closedtrades, "f_E110_closed", display = display.data_window)
