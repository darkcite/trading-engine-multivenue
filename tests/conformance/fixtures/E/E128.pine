//@version=6
strategy("E128", overlay = false, initial_capital = 1000000,
     default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 1,
     commission_type = strategy.commission.percent, commission_value = 0, slippage = 0,
     margin_long = 0, margin_short = 0, process_orders_on_close = false,
     calc_on_order_fills = false, calc_on_every_tick = false, use_bar_magnifier = false)
// E128 · strategy.order with a negative qty · E-r-p2 · dialects 56 · pin:05-bad-qty · generated by pine-conf gen; do not edit
strategy.order("L", strategy.long, qty = -1)
plot(strategy.position_size, "f_E128_pos", display = display.data_window)
