//@version=6
strategy("E106", overlay = false, initial_capital = 1000000,
     default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 1,
     commission_type = strategy.commission.percent, commission_value = 0, slippage = 0,
     margin_long = 0, margin_short = 0, process_orders_on_close = false,
     calc_on_order_fills = false, calc_on_every_tick = true, use_bar_magnifier = false)
// E106 · an entry on a realtime bar's first update · E-w21 · dialects 56 · pin:W21-intrabar-commit · generated by pine-conf gen; do not edit
varip int k_E106 = 0
varip int tl_E106 = 0
if time != tl_E106
    tl_E106 := time
    k_E106 := 0
k_E106 := k_E106 + 1
if barstate.isrealtime and k_E106 == 1 and strategy.position_size == 0
    strategy.entry("L1", strategy.long)
if barstate.isrealtime and barstate.isconfirmed and strategy.position_size > 0
    strategy.close("L1")
plot(strategy.position_size, "f_E106_pos", display = display.data_window)
