indicator("sheet-F-15", overlay = false)
// sheet-F-15 · v5 · F125 F126 F127 F128 · generated by pine-conf sheets; do not edit
// --- SYN-1 --- generated; do not edit. Every intermediate < 2^31, so every operation below is
// exact in binary64 and the series is bit-identical on any IEEE-754 engine.
var float _s = 1.0
var int   _n = 0
_n := _n + 1
_hi = math.floor(_s / 127773.0)
_lo = _s - _hi * 127773.0
_t  = 16807.0 * _lo - 2836.0 * _hi
_s := _t > 0.0 ? _t : _t + 2147483647.0
syn   = 1000.0 + (_s - math.floor(_s / 100000.0) * 100000.0) / 100.0
syni  = int(_s - math.floor(_s / 1000.0) * 1000.0)
synb  = syni >= 500
synna = syni < 100 ? na : syn
z_F125 = syn - syn
plot(0.1 + (syn - syn), "f_F125_c1", display = display.data_window)
plot((syn - syn) + 0.1, "f_F125_c1r", display = display.data_window)
plot(0.2 + 0.1 + (syn - syn), "f_F125_c2r", display = display.data_window)
plot(0.1 + 0.2 + z_F125, "f_F125_var", display = display.data_window)
plot((0.1 + 0.2) * (syn / syn), "f_F125_mul", display = display.data_window)
plot(0.1 + 0.2 + (close - close), "f_F125_close", display = display.data_window)
plot(0.5 + (syn - syn), "f_F125_half", display = display.data_window)
plot(math.max(0.1 + (syn - syn), 0.0), "f_F125_call", display = display.data_window)
a_F126 = array.from(10.0, 20.0, 30.0, 40.0)
b_F126 = array.from(10.0, na, 30.0, 40.0)
c_F126 = array.from(10, 20, 30, 40)
plot(array.percentrank(a_F126, 3), "f_F126_top", display = display.data_window)
plot(array.percentrank(a_F126, 1), "f_F126_second", display = display.data_window)
plot(array.percentrank(b_F126, 3), "f_F126_natop", display = display.data_window)
plot(array.percentrank(c_F126, 3), "f_F126_int", display = display.data_window)
m_F127 = math.sum(syn, 14)
plot(na(m_F127) ? 1 : 0, "f_F127_isna", display = display.data_window)
plot(na(m_F127) ? na : m_F127, "f_F127_val", display = display.data_window)
acc_F128 = 0.0
for i_F128 = 0 to 2
    acc_F128 += math.sum(syn, 3)
plot(na(acc_F128) ? 1 : 0, "f_F128_isna", display = display.data_window)
plot(na(acc_F128) ? na : acc_F128, "f_F128_val", display = display.data_window)
