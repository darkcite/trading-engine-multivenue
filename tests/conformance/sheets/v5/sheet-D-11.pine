indicator("sheet-D-11", overlay = false)
// sheet-D-11 · v5 · D050 D055 D056 D058 D059 · generated by pine-conf sheets; do not edit
h_D050 = request.security(syminfo.tickerid, "60", close)
plot(h_D050 == close ? 0 : 1, "f_D050_val", display = display.data_window)
