b_D055 = (time_close("1") - time) / 60000
plot(na(a_D055) ? 1 : 0, "f_D055_isna1", display = display.data_window)
plot(na(a_D055) ? na : a_D055, "f_D055_val1", display = display.data_window)
plot(na(b_D055) ? 1 : 0, "f_D055_isna2", display = display.data_window)
plot(na(b_D055) ? na : b_D055, "f_D055_val2", display = display.data_window)
t_D056 = time("60", "2200-0200:2")
plot(na(t_D056) ? 1 : 0, "f_D056_isna", display = display.data_window)
plot(syminfo.timezone == "Etc/UTC" ? 1 : 0, "f_D058_val1", display = display.data_window)
plot((time - time_tradingday) / 3600000, "f_D058_val2", display = display.data_window)
plot(session.isfirstbar ? 1 : 0, "f_D058_val3", display = display.data_window)
plot(session.islastbar ? 1 : 0, "f_D058_val4", display = display.data_window)
v_D059 = ta.vwap(close)
plot(na(v_D059) ? 1 : 0, "f_D059_isna", display = display.data_window)
plot(na(v_D059) ? na : v_D059, "f_D059_val", display = display.data_window)
