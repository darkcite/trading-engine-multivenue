# env.template — ~mv/multivenue/.env on the EC2 standalone (slot 11 alone).
# KEY NAMES ONLY. The operator fills the values ON THE HOST, by hand:
#
#   sudo -u mv -H install -m 0600 /dev/null ~mv/multivenue/.env   # then edit it as mv
#
# THE ONE ENV FILE on this host: the engine and daily units set
# MULTIVENUE_ENV_FILE=/home/mv/multivenue/.env, and everything that sources
# it finds it by that name — pmj-wrapper.sh, pmj-daily.sh, and the repo's
# scripts/pmj-exec.sh, pmj-flip.sh, pmj-dust.sh (run them with
# `env MULTIVENUE_ENV_FILE=/home/mv/multivenue/.env …`, README). No release
# carries a .env. The wrapper and the scripts refuse it (78), and the daily
# lane will not source it, unless it is a regular file (never a symlink),
# mode 0600, owned by `mv`, setting none of STRATEGY, ARM_LIVE, EXEC_TOML,
# PMJ_TOML (not even empty); it is sourced with `set -a`, its values never
# printed. A session never reads, prints or edits it (CLAUDE.md
# "Secrets").
# Endpoint values: copy them from the repo's .env.example (host names, not
# secrets). Nothing here is for the S3 archive: that is ~/multivenue/s3.env
# (s3.env.example), read by the archiver alone.

# ---- PAPER: what a boot with STRATEGY=pmj reads (core_config::Config::load) --
# REQUIRED by Config::load (env_req) — the wrapper refuses an empty one by name:
POLYMARKET_CLOB_HOST=
# the static market's socket AND the source of nothing slot 11 trades (BOOT-AUDIT C2)
POLYMARKET_GAMMA_HOST=
# the static market's boot discovery (Gamma)
BINANCE_WS_HOST=
# the Binance SPOT socket assert_bootable forces (btcusdt; BOOT-AUDIT C1)
ALCHEMY_HOST=
# required by Config::load, never dialed: the wrapper passes no --polygon-path (C5)

# OPTIONAL (built-in defaults shown in .env.example; set them to pin a host):
BINANCE_FUT_WS_HOST=
# bnbusdt's bookTicker + markPrice (the bnb family's nowcast, pmj.toml perp[6])
BINANCE_REST_HOST=
# spot exchangeInfo at boot (forced by the btcusdt anchor)
BINANCE_FUT_REST_HOST=
# USDⓈ-M exchangeInfo at boot (bnbusdt)
HYPERLIQUID_WS_HOST=
# the six HL perps (the other families' nowcasts)
HYPERLIQUID_API_HOST=
# HL /info at boot and on reconnect
MULTIVENUE_LOG_DIR=
# run dirs (default ~/multivenue/logs; keep it under ~/multivenue: the unit's only writable tree)
METRICS_BIND=
# /metrics and /state (default 127.0.0.1:9191; loopback only — the SSH tunnel reads it)
MULTIVENUE_MODE=
# `paper` makes the default explicit

# NOT SET on this host, on purpose:
#   AI_INGRESS_HMAC_KEY   — set, it opens ai.sock and the AI command plane; no
#                           member of STRATEGY=pmj reads it (BOOT-AUDIT)
#   POLYMARKET_EIP712_KEY — the legacy --live dispatcher's; never used here
#   ANTHROPIC_API_KEY     — no worker, no `serve` on this host
#   MULTIVENUE_S3_*       — ~/multivenue/s3.env only (S-LAW 6)

# ---- LIVE slot 11 (risk-policy J16): read ONLY by a live slot-11 boot and by
# `multivenue-engine pmj-exec --key-check` (scripts/pmj-exec.sh); a paper boot
# reads none of these. --------------------------------------------------------
PMJ_WALLET_KEYFILE=
# ABSOLUTE path of the 0600 Solana CLI keypair file (R-PMJ-S73), e.g. under
# ~mv/keys (0700): never inside a release, the repo, ~/multivenue or a synced
# directory; owner mv, mode exactly 0600, not a symlink (pmj_live::load_wallet)
PMJ_WALLET_PUBKEY=
# the wallet's public key, base58; the keypair's public half must equal it
JUP_API_KEY=
# Jupiter's API key (x-api-key); used only from a region Jupiter serves
PMJ_SOLANA_RPC=
# optional: a bare host for the key check's chain reads (default api.mainnet-beta.solana.com)

# ---- LATER, optional: the one-way Telegram notifier (N-DOCTRINE). Slots 9/11
# notifications are "Not now" (R-PMJ-S75); no notifier runs on this host. ----
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
