# ---------------------------------------------------------------------------
# Object-storage archive (S3-compatible cold tier) — TEMPLATE, placeholders only.
#
# Copy to ~/multivenue/s3.env and `chmod 600` it. That file is NEVER in git.
#
#   cp s3.env.example ~/multivenue/s3.env && chmod 600 ~/multivenue/s3.env
#
# S-LAW 6: only the Python loader (claude_worker.archive_config) reads this
# file. No shell script sources it. No value here may ever appear in argv, a
# log line, a manifest, a report, a URL, or an exception message.
#
# ENABLEMENT LAW: the subsystem is enabled iff MULTIVENUE_S3_ENABLED == "1" AND
# BUCKET, ENDPOINT, REGION, HOST_ID, ACCESS_KEY_ID and SECRET_ACCESS_KEY are all
# non-empty AND HOST_ID matches ^[a-z0-9][a-z0-9-]{0,31}$. Otherwise every code
# path is a no-op, no HTTP client is ever constructed, retention falls back to
# `compress`, and the resolver reports every run as local or absent.
#
# The process environment wins over this file; the file fills only the keys the
# environment lacks. A missing file is NOT an error — it simply means disabled.
# MULTIVENUE_S3_ENV_FILE (environment only, never set inside this file) names
# this file when it is not at the default ~/multivenue/s3.env.
#
# The engine never reads any of these keys. Nothing here enters the Cargo graph,
# pyproject.toml, or any hot path (S-LAW 1, S-LAW 10).
# ---------------------------------------------------------------------------

# 1 enables the subsystem; anything else (or absent) disables it.
MULTIVENUE_S3_ENABLED=0

# Endpoint host ONLY — no scheme, no bucket, no trailing slash.
MULTIVENUE_S3_ENDPOINT=fsn1.your-objectstorage.com

# SigV4 credential-scope region token.
MULTIVENUE_S3_REGION=fsn1

MULTIVENUE_S3_BUCKET=REPLACE_ME

# Credentials are created in the provider's console. Rotate them there if they
# are ever disclosed; nothing in this repo can rotate them for you.
MULTIVENUE_S3_ACCESS_KEY_ID=REPLACE_ME
MULTIVENUE_S3_SECRET_ACCESS_KEY=REPLACE_ME

# REQUIRED, explicit, ^[a-z0-9][a-z0-9-]{0,31}$. Never derived from the machine
# name: macOS renames LocalHostName on conflict, which would silently split the
# archive across two host ids. Data from a different host is a different
# population ("latency is measured per deployment").
MULTIVENUE_S3_HOST_ID=REPLACE_ME

# virtual = https://<bucket>.<endpoint>/<key>; path = https://<endpoint>/<bucket>/<key>
MULTIVENUE_S3_ADDRESSING=virtual

# Bucket layout version. A layout change is a NEW prefix, never an in-place
# rewrite, so this effectively never changes.
MULTIVENUE_S3_PREFIX=v1

# Pull cache + upload staging. Disposable by construction (S-LAW 9): the bucket
# holds everything under it, so it may be deleted at any moment without loss.
MULTIVENUE_S3_CACHE_DIR=~/multivenue/s3-cache

# Hard cap on <cache>/run-* plus staging.
MULTIVENUE_S3_CACHE_MAX_GIB=20

# Never pull or stage below this much free space on the volume. Keep it equal to
# retention.sh's MIN_FREE_GIB: the cache must never fill the disk that retention
# is trying to free (the 2026-09-02 ENOSPC wedge does not retry).
MULTIVENUE_S3_CACHE_MIN_FREE_GIB=25

# stdlib compression.zstd level for stored objects. Level 3 beats level 9 here
# end to end: 9 buys about a tenth off the stored size but costs roughly four
# times the CPU, and on a link this slow the compression time it adds exceeds the
# upload time it saves — while the CPU it takes is contended with the ingress
# threads whose venue-time staleness gate judges the data being captured.
MULTIVENUE_S3_ZSTD_LEVEL=3

# Objects at or above this size use multipart, with this part size.
# 5 MiB is the hard floor (a smaller non-final part makes the COMPLETE fail with
# EntityTooSmall — measured, not assumed); 10000 parts is the ceiling.
# 8 MiB, not the AWS-conventional 64: the part size is set by the UPLINK, not by
# convention. On this deployment, uploading under background QoS, a 64 MiB part
# did not finish inside a 120 s request timeout. Size a part so it completes in
# seconds, and resume granularity stays fine when one fails.
MULTIVENUE_S3_PART_SIZE_MIB=8

# Parts in flight. Keep at 1 while the engine is live: the uploader shares the
# box with the ingress threads whose venue-time staleness gate judges the data
# being captured while it runs.
MULTIVENUE_S3_CONCURRENCY=1

# Per-request timeout. Generous on purpose: downloads on this deployment measured
# slower than uploads, and the archiver runs at background QoS by design.
MULTIVENUE_S3_TIMEOUT_S=300

# Comma-separated globs excluded from upload. EMPTY = push everything.
MULTIVENUE_S3_SKIP_GLOBS=
