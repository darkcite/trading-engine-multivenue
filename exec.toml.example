# exec.toml — per-strategy execution mode (E1, real-execution plan §3.3)
#
# The live file is ~/multivenue/exec.toml and is NOT tracked. This
# example is, and it ships SAFE: nothing is armed. Copy it, then edit
# the copy.
#
#     cp exec.toml.example ~/multivenue/exec.toml
#
# There is deliberately NO default path: `--exec` must name its file
# explicitly, unlike every other artifact the engine loads. An artifact
# that auto-loads from a well-known path is one filesystem accident away
# from arming a slot nobody meant to arm.
#
# Note also that scripts/engine-wrapper.sh — which is what launchd
# actually runs — passes `--paper` and never passes `--exec`. Arming the
# managed fleet therefore takes a THIRD edit, to that wrapper.
#
#
# WHAT THIS FILE IS FOR
# ---------------------
# The engine runs ONE process with several strategy members composed
# into slots. Until this file existed, execution mode was a single
# process-wide `--paper` / `--live` flag: it could arm every member or
# none. This file moves the decision to the member, so one slot can
# trade real money while the others keep modelling.
#
# The routing key is `Order.strategy_id` — the slot byte every order
# already carries and that the strategy set already stamps. Nothing on
# the wire changed to make this work.
#
#
# ARMING TAKES TWO SWITCHES THAT MUST AGREE
# -----------------------------------------
# This file alone arms nothing. The command line alone arms nothing.
#
#     multivenue-engine run --strategy ai+vrp+xsd+bin15 \
#         --exec ~/multivenue/exec.toml \
#         --arm-live 3
#
# `--arm-live` must name EXACTLY the set of slots this file marks
# live. Artifact says live and the flag omits the slot -> boot refusal.
# Flag names a slot the file calls paper -> boot refusal. That is
# deliberate: a single edit, in either place, can never arm anything.
#
# This is also why execution lives in its own file rather than as a
# key in strategy.conf — a typo in the strategy selector must not be
# able to reach real money.
#
#
# THE SLOT MAP (must match `strategy-set`)
# ----------------------------------------
#   0  hyparb           4  ai-exec
#   1  vrp              5  vm
#   2  xsd              6  icdp
#   3  bin15            7  (reserved)
#
#
# THE THREE GRAMMAR LAWS
# ----------------------
# 1. An optional key must still be a KNOWN key. An unknown key or an
#    unknown section REFUSES the boot — it is never ignored. (A key the
#    parser read but had left out of its key list once refused the only
#    artifact the fitter wrote: BIN15 O4b. Hence the law.)
# 2. Absent = a STATED default, and the default is always the safe one.
#    An absent slot is paper. An ABSENT FILE is every slot paper, which
#    is the engine's behaviour bit for bit before this file existed.
# 3. Nothing is clamped at boot. Every bound is checked at parse, with
#    its line number, so a bad number refuses loudly instead of being
#    quietly reduced and discovered later in a report.
#
#
# [exec] — the policy section. REQUIRED (even if empty).
[exec]

# enabled: 1 (default) or 0.
#
# `enabled = 0` makes the WHOLE file inert — every slot paper — without
# touching a single slot section. It is the one-line kill switch: flip
# it, restart, and every member is modelling again with the live
# configuration still on disk, intact, ready to be re-armed.
enabled = 1


# ---------------------------------------------------------------------
# [exec.slot.<n>] — one section per slot you want to say something
# about. Every key below is optional. Omit the section entirely and the
# slot is paper.
# ---------------------------------------------------------------------

# Slot 3 — bin15 (Outcome.xyz HIP-4 on Hyperliquid).
#
# SHIPPED AS PAPER. Change `mode` to "live" only when the live arm for
# the venue actually exists in the binary (E2/E3) — until then a live
# slot REFUSES the boot rather than booting inert, and says so.
[exec.slot.3]

# mode: "paper" (default) | "live" | "off"
#
#   paper — orders go to the paper matcher. What every slot does unless
#           told otherwise.
#   live  — orders go to the venue. Needs `venues`, needs --arm-live to
#           name this slot, and needs a compiled live arm.
#   off   — the slot may not PLACE at all; every submit and modify is
#           refused and counted. Not the same as paper: `off` is
#           "stop", paper is "model it". Use it to silence a member
#           without rebuilding the strategy mask.
#
#           *** USE `off` ONLY ON A FLAT SLOT. ***
#
#           `off` refuses every submit and modify — entries and EXITS
#           alike. An Order carries no reduce-only bit, so the
#           dispatcher cannot tell an exit from an entry.
#
#           A CANCEL passes (E7 review ruling, 2026-09-19): it is the
#           only verb that can only reduce risk, and the halt machine's
#           own law — "a cancel is the only way to get flat and must
#           never be blocked" — holds for `off` too. Before this, a slot
#           flipped live → off across a restart still had its orders
#           resting at the venue and NO in-engine path to take them
#           back (the halt sweep skips non-live slots). Now the member's
#           own cancel path reaches the live arm on an `off` slot,
#           counted `cancel_on_off`.
#
#           `off` is still a deliberate, documented exception to the
#           standing law in docs/risk-policy.md that "a cap never blocks
#           an EXIT": `off` is not a cap, it is an operator stop, and it
#           can strand a POSITION (not a resting order). Members clear
#           their logical position when they submit an exit whether or
#           not the submit succeeded, so flipping a holding slot to
#           `off` silently desynchronises the member from the book.
#
#           To stop a slot that HOLDS a position, set it to `paper`
#           (or stop the engine) and let the member's own exit law
#           unwind. There is NO reduce-only exemption; E6 shipped none.
mode = "paper"

# name: which member the operator believes occupies this slot.
# REQUIRED whenever `mode = "live"`; checked at boot against the
# binary's own slot map, and a mismatch REFUSES the boot.
#
# Why a name as well as a number: slot numbers get REASSIGNED. Slot 1
# went ev -> vrp on 2026-09-10; slot 2 went cross-arb -> xsd and slot 3
# went rule-tree -> bin15 on 2026-09-12. An exec.toml written against
# one map and reused after the next reassignment would arm a DIFFERENT
# member, silently. The name turns that into a refusal.
name = "bin15"

# venues: which venues this slot may reach when live. Required for
# `mode = "live"` (a live slot with no venue could only ever refuse its
# own orders, so it is a parse error rather than a puzzle at runtime).
#
# Known spellings — the same ones universe.toml uses:
#   polymarket  binance  okx  deribit  hyperliquid  ai  bybit  mexc
#
# `mexc` (byte 7) is reserved so an artifact can NAME the venue; MEXC is
# DATA-ONLY (docs/mexc-ingress-plan.md, ruling O-MX1) — no execution arm,
# so a live slot naming it refuses the boot like any venue without one.
#
# A LIVE SLOT NEVER FALLS BACK TO PAPER (law E-1). An order naming a
# venue not listed here is refused and counted, never modelled — a
# modelled fill wearing live semantics would put a trade that never
# happened into the P&L.
venues = ["hyperliquid"]

# --- Risk-gate clamps ------------------------------------------------
# Defence in depth OVER the member's own caps, and computed from VENUE
# fills rather than from what the member believes. A member bug that
# forgets its own cap still cannot spend more than these say.
#
# *** ENFORCED SINCE E6 (2026-09-19). *** Every live submit and modify
# passes `RoutedDispatcher::risk_check` against all four clamps before
# it can leave the host, plus the seeding interlock (no live PLACE until
# the arm has reconciled against the venue) and the sticky halt latch.
# The boot tell prints `caps-ENFORCED` on a live slot. The member's own
# caps (bin15.toml's cap_instance_usd_1e6 / cap_day_usd_1e6) stay in
# force on the SIZING path; these are the second opinion on the
# DISPATCH path, and a non-zero `refused_max_order` means the two
# disagreed — that disagreement is the alarm.
#
# What the ledger-fed clamps cannot bound, stated plainly: they are
# computed from FILLS, so N orders in flight are each judged against the
# same position. The worst case with every quote working is
# cap_instance_usd + max_open_orders × max_order_usd, not
# cap_instance_usd. The three numbers multiply — set them together.
#
# These caps are PER SLOT, not global. `max_open_orders = 64` here is
# eight slots at 64 = 512 live orders across the table (that is what
# LEDGER_RESTING is sized to). risk-policy.md's "max total open orders
# 64" line is the PAPER model's (cli::backtest::fill); the engine
# enforces the per-slot number.
#
# `0` means UNSET, and unset must NEVER come to mean "unlimited" — the
# same ruling risk-policy.md already made for the Deribit coin caps. A
# live slot must state max_order_usd_1e6 and cap_instance_usd_1e6
# non-zero or the boot is refused.
#
# They are written here now so that arming later changes one word, not a
# whole file.

# Largest single order, USD x1e6. 100000000 = $100.
# REQUIRED (non-zero) for a live slot: `0` means UNSET here and unset
# must never come to mean "unlimited" — the same ruling risk-policy.md
# already made for the Deribit coin caps.
max_order_usd_1e6 = 100000000

# Most orders this slot may have resting at once.
max_open_orders = 64

# Day turnover ceiling, USD x1e6. 30000000000 = $30,000.
# Ruling O-E4: the caps stay EXACTLY as paper for the live ramp. The
# ramp throttles on which arms are enabled, not by shrinking caps.
# Note a day cap is a TURNOVER limit, not a funding requirement — it is
# not how much has to be on deposit.
cap_day_usd_1e6 = 30000000000

# Per-instance ceiling, USD x1e6. 1000000000 = $1,000.
# REQUIRED (non-zero) for a live slot, for the same reason as above.
cap_instance_usd_1e6 = 1000000000

# Hyperliquid's request budget is address-based: 10,000 + one request
# per USDC of lifetime volume, and an exhausted address falls to ONE
# request every 10 seconds. Stop placing when the remaining budget
# drops below this, so a bad fill rate cannot brick the address.
# Consumed by the budget governor in E4.
request_budget_floor = 2000

# ---- the kill switches (E6) -----------------------------------------
#
# All five are REQUIRED NON-ZERO on a live slot and the boot refuses
# without them, naming the key. `0` means UNSET here, never
# "unlimited": a halt trigger with no threshold never fires, so a
# missing key would be a kill switch that silently does not exist.
#
# A halt is STICKY. Nothing in the process clears it — not a recovered
# stream, not a successful reconciliation. It cancels everything this
# arm has working at the venue, refuses every further submit and
# modify (cancels still pass, so a member can always get out), and
# writes `exec.HALT` beside this file so it survives the restart.

# Consecutive venue rejections that trip a halt.
halt_on_reject_streak = 5

# Divergence between our position and the venue's, USD x1e6, that trips
# a halt. 5000000 = $5.
halt_on_recon_drift_usd_1e6 = 5000000

# Milliseconds of silence on the venue's user-event stream that trip a
# halt. The stream is how fills arrive (LAW E-5), so a quiet stream
# means we are placing orders blind. 30000 = 30s.
halt_on_ws_gap_ms = 30000

# Consecutive orders refused locally because their asset id was not
# bound by a roll event (LAW E-4). A streak means our view of the
# instrument has diverged from the venue's.
halt_on_asset_refusal_streak = 3

# Milliseconds since the last reconciliation that AGREED with the venue
# before a halt. The reconciler runs every 60 s and is the one check
# independent of every belief the engine holds; when it stops answering
# (or stops agreeing) the safety net is dark, and this is what notices.
# 300000 = 5 min tolerates a hiccup and halts an outage.
halt_on_recon_stale_ms = 300000

# ---- the SESSION BOUND (E7, OPTIONAL) ---------------------------------
#
# The operator's stopping rule — "run until it either earns +N or loses
# M" — as a sticky halt (`pnl-gain` / `pnl-loss`), NOT a fault
# detector: both keys are optional even on a live slot, `0` (or absent)
# is "no bound on that side", and the five kill switches above stay
# required whatever these say.
#
# Measured from the account's SPOT USDC as the reconciler reads it
# every 60 s, against an ANCHOR: the balance at the first reconciliation
# that found the account FLAT (no outcome leg held). The anchor is
# written once to `exec-pnl-anchor.state` beside this file and restored
# on every restart, so the session outlives the process (KeepAlive
# relaunches it) — delete that file before a restart to start a new
# session. The bound is judged ONLY while flat: an open leg's premium
# is not a loss and its payout is not a gain until the venue settles.
# `/state` shows `arm_pnl_anchor_usd_1e6` and `arm_session_pnl_usd_1e6`;
# `/metrics` the same two as gauges.
#
# USD x1e6. 15000000 = +$15 halts; 5000000 = -$5 halts.
# halt_on_gain_usd_1e6 = 15000000
# halt_on_loss_usd_1e6 = 5000000


# Slot 1 — vrp. Explicit is better than default: writing it down means
# a reader of this file knows the slot was considered, not forgotten.
[exec.slot.1]
mode = "paper"


# Slot 0 — hyparb (HyperEVM AMM <-> Hyperliquid perp hedge, HYPARB §17).
#
# SHIPPED AS PAPER. Paper = the testnet shadow (hyparb.toml
# `mode = "testnet"`); live = HyperEVM MAINNET swaps through the H9d
# executor plus real HL perp hedges, BOTH from slot 0's OWN wallet X
# (`HYPEREVM_MAINNET_KEY`), never the bin15 account.
#
# The flip is THREE switches that must agree, or the boot refuses:
#   1. hyparb.toml   mode = "live"  (+ its [mainnet] executor)
#   2. this section  mode = "live", venues EXACTLY both below
#   3. --arm-live    names 0        (strategy.conf ARM_LIVE=0,3 + HYPARB_LIVE=1)
#
# Slot 0's state (X's HL budget, the HL anchor, the equity anchor
# `hyparb-equity-anchor.state`) lives in `hyparb/` beside this file —
# never slot 3's files. Delete the equity anchor to start a new session.
#
# The P&L bound is LIVE-ONLY and is COMBINED EQUITY: X's HL perp account
# value + HL spot USDC + the executor's tokens at mids + X's HYPE gas,
# judged only while flat (no swap in flight, 2 s quiet). Paper has none.
#
# Caps are USD x1e6 (every traded pool is USD-quoted — hyparb.toml's
# live check refuses any other). Sized for the ~$115 wallet:
[exec.slot.0]
mode = "paper"
# mode = "live"
# name = "hyparb"
# venues = ["hyperliquid", "hyperevm"]
# max_order_usd_1e6 = 25000000
# max_open_orders = 8
# cap_day_usd_1e6 = 2000000000
# cap_instance_usd_1e6 = 60000000
# request_budget_floor = 2000
# halt_on_reject_streak = 5
# halt_on_recon_drift_usd_1e6 = 5000000
# halt_on_ws_gap_ms = 30000
# halt_on_asset_refusal_streak = 3
# halt_on_recon_stale_ms = 120000
# halt_on_gain_usd_1e6 = 50000000
# halt_on_loss_usd_1e6 = 20000000
