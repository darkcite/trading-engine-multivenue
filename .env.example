# ---------------------------------------------------------------
# Multivenue Trading Engine — .env.example
#
# Copy this file to `.env` and fill in real values.
#
#     cp .env.example .env
#     chmod 600 .env
#
# `.env` is git-ignored. `.env.example` is committed.
#
# The binary loads this file once at boot via `dotenvy` in
# `core-config`. The signing key bytes are copied into an
# `mlock`'d page immediately after parsing and zeroized on drop.
#
# EVERY key in this file is consumed by `core_config::Config` or
# `core_config::Secrets`. Adding a key here without wiring it
# silently disables it — keep them in sync.
# ---------------------------------------------------------------

# ---- Polymarket signing key (REQUIRED for --live; ignored for --paper) ----
# Hex-encoded secp256k1 private key exported from MetaMask for the
# funder wallet. Used for EIP-712 CLOB order signing. Never commit.
POLYMARKET_EIP712_KEY=0x00000000000000000000000000000000000000000000000000000000deadbeef

# ---- Endpoints (all REQUIRED) ----
# WSS host for CLOB book frames (the real-time subscriptions host —
# NOT clob.polymarket.com, which is REST-only; verified live 2026-08-14).
POLYMARKET_CLOB_HOST=ws-subscriptions-clob.polymarket.com
# HTTPS host for market metadata.
POLYMARKET_GAMMA_HOST=gamma-api.polymarket.com
# WSS host for Binance bookTicker.
BINANCE_WS_HOST=stream.binance.com
# WSS host for Polygon RPC (newHead subscription).
ALCHEMY_HOST=polygon-mainnet.g.alchemy.com

# ---- RSS feeds (OPTIONAL — empty = no RSS thread) ----
# Comma-separated URLs. Polled at the cadence baked into
# `ingress-rss::poller`.
RSS_FEEDS=https://cointelegraph.com/rss,https://www.theblock.co/rss.xml

# ---- Claude (OPTIONAL — only used by `claude-worker/`, never by the engine) ----
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# ---- Runtime knobs (OPTIONAL — sane defaults built-in) ----
# Log dir for HdrHistogram dumps + replay log. A leading `~/` is
# expanded against $HOME at load time (core_config::expand_tilde).
MULTIVENUE_LOG_DIR=~/multivenue/logs
# /metrics endpoint (loopback only).
METRICS_BIND=127.0.0.1:9191
# Paper mode is the default — set to `paper` to make it explicit.
MULTIVENUE_MODE=paper

# ---- §9 Phase-8e venue hosts (OPTIONAL — sane defaults built-in) ----
# Every operator's existing .env keeps working unchanged: these are
# only consulted when the corresponding --okx-symbols /
# --deribit-symbols / --hl-coins flag is set (WS) or REST discovery
# runs at boot (plan §6.1). WS paths themselves stay hardcoded cli
# consts (/ws/v5/public, /ws/api/v2, /ws) — only the host (+ optional
# :port) is configurable here.
#
# OKX v5 public WS host — carries the venue's non-443 WS port.
OKX_WS_PUBLIC_HOST=ws.okx.com:8443
# OKX REST host for boot-time instrument discovery
# (GET /api/v5/public/instruments).
OKX_REST_HOST=www.okx.com
# Deribit WS host (JSON-RPC over WS).
DERIBIT_WS_HOST=www.deribit.com
# Deribit REST host for boot-time instrument discovery
# (GET /api/v2/public/get_instruments).
DERIBIT_REST_HOST=www.deribit.com
# Hyperliquid public WS host.
HYPERLIQUID_WS_HOST=api.hyperliquid.xyz
# Hyperliquid /info REST host for boot-time asset discovery.
HYPERLIQUID_API_HOST=api.hyperliquid.xyz
