# retention.conf — M3 capture-retention policy (copy to
# ~/multivenue/retention.conf; absent file = these defaults).
# Sourced by scripts/retention.sh (KEY=VALUE shell syntax), which
# runs once per UTC day from the daily-restart poller.
#
# Policy: KEEP-ALL until disk pressure. Only when the log volume's
# free space is under MIN_FREE_GIB are the OLDEST run dirs archived
# (tar -cz — bsdtar-internal gzip — into ARCHIVE_DIR, original
# removed after a verified archive) until TARGET_FREE_GIB. The newest run
# dir (live capture) and anything younger than PROTECT_DAYS are never
# touched. Archives are never auto-deleted — pruning
# ~/multivenue/archive is yours. `capture-catalog` reports per-run
# sizes; use it to decide.

MIN_FREE_GIB=25
TARGET_FREE_GIB=40
PROTECT_DAYS=7

# ---- "keep only the last N hours" (requires ARCHIVE_MODE=s3) ----
# The defaults above are PRESSURE-driven: nothing is deleted until the volume
# drops under MIN_FREE_GIB. If instead you want a fixed local window — keep the
# last 24 h on disk, everything older in object storage and pulled on demand —
# make the thresholds unreachable so the sweep runs every night, and let
# PROTECT_DAYS define the window:
#
#   MIN_FREE_GIB=999999      # never satisfied -> the sweep always runs
#   TARGET_FREE_GIB=999999   # never satisfied -> walk every candidate
#   PROTECT_DAYS=1           # keep the last 24 h; older is eligible
#   ARCHIVE_MODE="s3"
#
# The failure mode is unchanged and is the point: each deletion is gated on
# `verify` exiting 0, and the FIRST run that is not confirmed in the bucket
# stops the sweep with everything after it intact. Set this only once a backfill
# has actually put the history there — otherwise the sweep correctly refuses to
# free anything, and the volume keeps filling.
ARCHIVE_DIR="$HOME/multivenue/archive"
# compress (default) | move | s3
#   compress — tar -cz into ARCHIVE_DIR, then remove the original.
#   move     — only makes sense when ARCHIVE_DIR sits on a DIFFERENT
#              volume (same-volume moves free nothing).
#   s3       — retention stage B: delete a run dir ONLY after the
#              archiver verifies the bucket holds it (index object
#              present, manifest byte-identical, every object HEADs with
#              the recorded size and ETag). An unverified run is KEPT and
#              the sweep stops there: disk pressure is never a reason to
#              lose the only copy of anything. Falls back to `compress`
#              when the archiver is not installed.
#              Uploading is NOT done here — it is a separate daily agent
#              (com.multivenue.archive), deliberately outside the restart
#              lane, so nothing slow can stall the 0000Z tick.
ARCHIVE_MODE="compress"

# ---- object-storage archive (ARCHIVE_MODE=s3 only) ----
# Wall budget for one run of the upload cycle (stage A). The cycle stops
# cleanly when it is spent and resumes where it left off next time — a
# half-uploaded run has no manifest and no index, so no reader can see it.
S3_CYCLE_BUDGET_S=600

# Only when the credentials are NOT at the default ~/multivenue/s3.env.
# Both scripts export it; neither ever READS the file — only the Python
# loader does, which is what keeps the secret out of the process table.
# MULTIVENUE_S3_ENV_FILE="/abs/path/to/s3.env"
