//@version=6
// impl-07 §7.6 probe (ours): close[1] with lookahead_on — leak-free, so live_bound admits it.
strategy("htf lookahead", overlay=true)
h = request.security(syminfo.tickerid, "240", close[1], lookahead = barmerge.lookahead_on)
plot(h)
if close > h
    strategy.entry("L", strategy.long)
if close < h
    strategy.close("L")
