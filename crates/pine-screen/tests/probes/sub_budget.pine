//@version=6
// impl-07 §7.6 probe (ours): the sub-program exhausts its instruction budget at HTF bar 10.
strategy("sub budget")
burn() =>
    float x = 0.0
    if bar_index == 10
        for i = 0 to 100000000
            x += 1
    close + x
h = request.security(syminfo.tickerid, "240", burn())
plot(h)
if close > h
    strategy.entry("L", strategy.long)
