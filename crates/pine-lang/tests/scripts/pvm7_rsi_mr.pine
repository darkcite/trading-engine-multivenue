//@version=6
//
// RSI mean reversion. OUR CODE, typed from the public rule: buy when a 14-period RSI crosses back up
// through an oversold level, exit when it crosses up through a neutral level. The fee-hurdle
// exemplar: at 1 m it trades far too often to clear a taker round trip.
strategy("PVM7 RSI mean reversion", overlay = false, initial_capital = 100000,
     default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 0)

len   = input.int(14, "RSI length", minval = 2, maxval = 200)
osLvl = input.int(30, "Oversold",   minval = 1, maxval = 49)
exLvl = input.int(50, "Exit level", minval = 2, maxval = 98)

r        = ta.rsi(close, len)
entrySig = ta.crossover(r, osLvl)
exitSig  = ta.crossover(r, exLvl)

if entrySig
    strategy.entry("L", strategy.long)
if exitSig
    strategy.close("L")

plot(r, "RSI")
hline(osLvl, "OS")
hline(exLvl, "EX")
