//@version=6
x = if close > open
    1
else if close < open
    -1
else
    0
for i = 0 to 10 by 2
    if i == 4
        continue
    x += i
for int j = 10 to 0
    break
for v in array.from(1, 2, 3)
    x += v
for [k, val] in map.new<string, float>()
    x := x + val
while x > 0
    x -= 1
s = switch x
    1 => "one"
    2 =>
        t = "two"
        t
    => "other"
switch
    x > 1 => label.new(bar_index, high, "a")
    => na
once
    y = 1
once barstate.islast
    y = 2
