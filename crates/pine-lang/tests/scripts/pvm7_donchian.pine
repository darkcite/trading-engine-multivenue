//@version=6
//
// Donchian channel breakout, Turtle shape. OUR CODE, typed from the public rule: rest a stop entry at
// the N-bar high and a stop exit at the M-bar low. The channel EXCLUDES the current bar, so the [1]
// is load-bearing.
strategy("PVM7 Donchian", overlay = true, initial_capital = 100000,
     default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 0)

entryLen = input.int(20, "Entry length", minval = 2, maxval = 500)
exitLen  = input.int(10, "Exit length",  minval = 2, maxval = 500)

upper = ta.highest(high, entryLen)[1]
lower = ta.lowest(low,  exitLen)[1]

if not na(upper)
    strategy.entry("L", strategy.long, stop = upper)
if not na(lower)
    strategy.exit("X", "L", stop = lower)

plot(upper, "Upper")
plot(lower, "Lower")
