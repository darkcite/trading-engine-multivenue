//@version=6
//
// Bollinger-in-Keltner squeeze. OUR CODE, typed from the public rule: a squeeze holds while the
// Bollinger band sits inside the Keltner channel; when it releases, take the sign of a
// linear-regression momentum term (long if positive, short if negative); flat when that term crosses
// zero against the position (pin:07-squeeze-exit — the rule names no exit).
strategy("PVM7 Keltner squeeze", overlay = false, initial_capital = 100000,
     default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 0)

bbLen  = input.int(20, "BB length", minval = 2, maxval = 500)
bbMult = input.float(2.0, "BB multiple", minval = 0.5, maxval = 5.0, step = 0.1)
kcLen  = input.int(20, "KC length", minval = 2, maxval = 500)
kcMult = input.float(1.5, "KC multiple", minval = 0.5, maxval = 5.0, step = 0.1)
momLen = input.int(20, "Momentum length", minval = 2, maxval = 500)

[bbMid, bbUp, bbLo] = ta.bb(close, bbLen, bbMult)
[kcMid, kcUp, kcLo] = ta.kc(close, kcLen, kcMult)
hh  = ta.highest(high, momLen)
ll  = ta.lowest(low, momLen)
avg = ta.sma(close, momLen)
mom = ta.linreg(close - math.avg(math.avg(hh, ll), avg), momLen, 0)
momUp = ta.crossover(mom, 0)
momDn = ta.crossunder(mom, 0)

squeeze = bbUp < kcUp and bbLo > kcLo
release = squeeze[1] and not squeeze

if release and mom > 0
    strategy.entry("L", strategy.long)
if release and mom < 0
    strategy.entry("S", strategy.short)
if momDn
    strategy.close("L")
if momUp
    strategy.close("S")

plot(mom, "Momentum")
bgcolor(squeeze ? color.new(color.red, 85) : na)
barcolor(mom > 0 ? color.lime : color.maroon)
