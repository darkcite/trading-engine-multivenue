//@version=6
//
// OUR CODE: sets its stop once, at entry (Q1's once-at-entry script, impl-08 T16).
strategy("exit once (strategy-pine T16)", overlay = true)
plot(close)
if strategy.position_size == 0
    strategy.entry("L", strategy.long)
    strategy.exit("X", "L", stop = close * 0.9)
