//@version=6
//
// Supertrend, hand-written for the strategy-pine load tests (impl-08 T5). OUR CODE, typed from
// the public rule: an ATR band either side of hl2 ratchets with the trend, and the trend flips
// when the close crosses the band. Long while the trend is up; optionally short while it is down.
strategy("Supertrend (strategy-pine T5)", overlay = true, initial_capital = 100000,
     default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 0)

atrLen   = input.int(10, "ATR length", minval = 1, maxval = 200)
factor   = input.float(3.0, "Factor", minval = 0.5, maxval = 10.0, step = 0.1)
longOnly = input.bool(true, "Long only")

atr      = ta.atr(atrLen)
upperRaw = hl2 + factor * atr
lowerRaw = hl2 - factor * atr

var float lo = na
var float hi = na
var int dir = 1
prevLo = nz(lo, lowerRaw)
prevHi = nz(hi, upperRaw)
lo := lowerRaw > prevLo or close[1] < prevLo ? lowerRaw : prevLo
hi := upperRaw < prevHi or close[1] > prevHi ? upperRaw : prevHi
dir := dir == -1 and close > prevHi ? 1 : dir == 1 and close < prevLo ? -1 : dir
st = dir == 1 ? lo : hi

if dir == 1 and dir[1] == -1
    strategy.entry("L", strategy.long)
if dir == -1 and dir[1] == 1
    strategy.close("L")
    if not longOnly
        strategy.entry("S", strategy.short)

plot(st, "Supertrend")
