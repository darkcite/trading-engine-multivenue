//@version=6
//
// OUR CODE: re-issues a protective stop on every bar (Q1's re-issuing script, impl-08 T16).
strategy("exit reissue (strategy-pine T16)", overlay = true)
plot(close)
if strategy.position_size == 0
    strategy.entry("L", strategy.long)
strategy.exit("X", stop = close * 0.9)
