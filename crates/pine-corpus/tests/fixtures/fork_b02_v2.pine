indicator("RSI Bands", overlay = false)
len = input.int(14, "Length")
src = input.source(close, "Source")
r = ta.rsi(src, len)
plot(r, title = "R", linewidth = 2)
hline(70, title = "Hi")
hline(30, "Lower", color = color.green)
