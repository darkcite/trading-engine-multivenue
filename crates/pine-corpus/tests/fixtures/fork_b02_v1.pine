indicator("RSI Bands", overlay = false)
len = input.int(21, "Len")
src = input.source(close, "Source")
r = ta.rsi(src, len)
plot(r, "RSI", color = color.purple)
hline(70, "Upper", color = color.red)
hline(30, "Lower", color = color.green)
