strategy("Breakout", overlay = true)
look = input.int(20, "Lookback")
hi = ta.highest(high, look)
lo = ta.lowest(low, look)
if close > hi[1]
    strategy.entry("L", strategy.long)
if close < lo[1]
    strategy.entry("S", strategy.short)
plot(hi)
plot(lo)
