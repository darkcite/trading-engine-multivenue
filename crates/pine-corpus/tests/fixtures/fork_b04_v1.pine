strategy("Breakout", overlay = true)
lb = input.int(20, "Lookback")
top = ta.highest(high, lb)
bot = ta.lowest(low, lb)
if close > top[1]
    strategy.entry("L", strategy.long)
if close < bot[1]
    strategy.entry("S", strategy.short)
plot(top)
plot(bot)
