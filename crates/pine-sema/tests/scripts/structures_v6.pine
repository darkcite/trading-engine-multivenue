//@version=6
indicator("structures")
v = 0.0
for j = 0 to 2
    v += close
n = 0
while true
    n += 1
    if n >= 4
        break
var float acc = 0.0
acc := acc + 1.0
k = bar_index % 3
up = close > open and ta.sma(close, 3) > close[1]
dn = close < open or ta.ema(close, 5) < close
w = switch
    up => 1
    dn => -1
    => 0
t = bar_index % 2 == 0 ? ta.sma(close, 4) : ta.ema(close, 4)
plot(v + n + acc)
plot(close[k])
plot(w)
plot(t)
