//@version=5
indicator("structures v5")
var int c = 0
c += 1
x = na(c[1]) ? -1 : c[1]
b = close > open and close[1] > open[1]
s = 0.0
for i = 5 to 1
    s += i
plot(x)
plot(b ? 1 : 0)
plot(s)
plot(close % 7)
plot(bar_index / 2)
