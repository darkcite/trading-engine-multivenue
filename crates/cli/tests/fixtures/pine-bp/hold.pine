//@version=6
//
// OUR CODE: enters on a bar close while flat and closes on the next bar close while long — the
// B'3 T13 cross-cut hold probe (impl-Bp I15).
strategy("bp hold (cli B'3 T13)", overlay = true)
plot(close)
if strategy.position_size == 0
    strategy.entry("L", strategy.long)
else
    strategy.close("L")
