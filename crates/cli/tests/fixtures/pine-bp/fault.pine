//@version=6
//
// OUR CODE: enters while flat, then runs out of its per-evaluation instruction budget at its
// first evaluation holding the position — the B'3 T13 fault-abort probe (impl-Bp I16).
strategy("bp fault (cli B'3 T13)", overlay = true)
float x = 0.0
if strategy.position_size > 0
    for i = 0 to 100000000
        x := x + 1
plot(x)
if strategy.position_size == 0
    strategy.entry("L", strategy.long)
