<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.multivenue.llm</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>@REPO@/scripts/llm-serve.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>WorkingDirectory</key><string>@REPO@</string>
  <key>StandardOutPath</key><string>@HOME@/multivenue/logs/launchd/llm.log</string>
  <key>StandardErrorPath</key><string>@HOME@/multivenue/logs/launchd/llm.log</string>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>10</integer>
</dict>
</plist>
