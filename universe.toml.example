# universe.toml — boot-universe config (Stage 2.5 M1; docs/mvp-progress.md)
#
# Copy to ~/multivenue/universe.toml (the default path; --universe <path>
# overrides). Absent file + no flag = legacy flag-driven boot. Per-venue
# CLI flags OVERRIDE that venue's section when explicitly passed.
#
# Grammar is a strict TOML subset (core-config::universe): [sections],
# key = ["string", …] arrays (multiline ok, trailing comma ok),
# key = true|false, key = <bare decimal integer> (M2.1: options knobs
# — no sign, no `_`, no leading zeros). Unknown sections/keys are
# fatal. No escapes in strings. A `#` inside a string (e.g. HIP-4
# "#330") is literal.

[polymarket]
# M1-R1 (operator ruling): crypto up/down binary markets ONLY.
# Entry forms:
#   "<token-id>"        — one market, single CLOB token (decimal string)
#   "<yes-id>:<no-id>"  — one market, YES/NO token pair
# NOTE: crypto up/down markets are short-dated — refresh this list via
# the worker Gamma lane (semi-manual until M3's daily-restart recipe).
# SymbolIds: first token → 42 (legacy anchor), then namespaced ordinals.
markets = [
  "57748138085022719760345772310040703848567377822400132842014290209986511882046",
]

[binance]
# Lowercase stream symbols. spot[0] → SymbolId 7 (legacy anchor), then
# namespaced; usdm ordinals live in a disjoint block (base 512).
# usdm streams connect to BINANCE_FUT_WS_HOST (default fstream.binance.com).
spot = ["btcusdt"]
usdm = []
# WS5: USDS-M DATED (delivery) futures — `<base>_<yymmdd>` stream names
# (e.g. "btcusdt_260327"; the underscore is required — it is what
# separates the class from `usdm`). Same host + streams as usdm; own
# ordinal block (base 2048). Discovery refuses a non-dated symbol here.
# Every usdm + usdm_dated instrument also gets a capture-only
# `@markPrice` connection (mark/index/funding events; dated contracts
# carry no funding by design).
usdm_dated = []
# M2.4 capped options chain — same law as [deribit]/[okx]; underlyings
# are eapi names (e.g. "BTCUSDT"); discovered instruments join the
# eapi combined stream (BBO ticks + OptSummary records; no OI on this
# venue's stream — flags say so).
options_underlyings = []   # e.g. ["BTCUSDT", "ETHUSDT"] — empty/absent = lane OFF
# options_expiries = 2     # E: nearest expiries, 1..=4 (default 2)
# options_strikes = 8      # K: even, 2..=32 (default 8 = ATM±4)

[okx]
# instIds, file order = ordinal order (make_symbol_id(Okx, i+1)).
instruments = []
# Also subscribe the 400-level books channel (capture + integrity only).
depth = false
# M2.2 capped options chain — same law as [deribit] below, but
# underlyings are OKX `uly` families (e.g. "BTC-USD", "ETH-USD");
# discovered instruments subscribe bbo-tbt ONLY (opt-summary at M2.3).
options_underlyings = []   # e.g. ["BTC-USD", "ETH-USD"] — empty/absent = lane OFF
# options_expiries = 2     # E: nearest expiries, 1..=4 (default 2)
# options_strikes = 8      # K: even, 2..=32 (default 8 = ATM±4)

[deribit]
# Instrument names, file order = ordinal order. WS6: SPOT instruments
# (no `-` in the name, e.g. "BTC_USDC") are a recognized class — they
# subscribe quote + trades (+book with depth), never the ticker (no
# funding/OI/mark analytics on spot).
instruments = []
depth = false
# WS6: option COMBO instruments (explicit venue names; quote-only BBO
# capture — combo ORDERS stay Stage-3). Combos share the venue's
# 64-row tail block with the discovered options chain (shrink E/K to
# fit a long list). NO boot REST validation: a misspelled combo never
# appears in the subscribe echo, which the first-ever verification
# treats as a fatal misconfiguration (fail-fast at boot).
combos = []                # e.g. ["BTC-FS-27MAR26_PERP"]
# M2.1 capped options chain (docs/m2-progress.md design entry): boot
# DISCOVERS the nearest `options_expiries` expiries × the
# `options_strikes` strikes nearest ATM (K/2 either side of the index
# price, calls+puts ⇒ ≤ E×K×2 instruments per underlying) for each
# listed underlying currency. Empty/absent list = options lane OFF.
# Chains roll at the NEXT boot (M3's daily restart refreshes). The
# integer knobs are only legal when underlyings are configured;
# E 1..=4 (default 2), K even 2..=32 (default 8 = ATM±4).
options_underlyings = []   # e.g. ["BTC", "ETH"]
# options_expiries = 2
# options_strikes = 8
# WS6: each configured underlying ALSO subscribes its DVOL volatility
# index (`deribit_volatility_index.<uly>_usd` → VolIndex capture
# events). No extra key; an index the venue does not serve simply
# never echoes (missing series, never an error).

[hyperliquid]
# Coins; HIP-4 "#<enc>" outcome coins and spot "@<idx>" pairs are
# ordinary items.
coins = []
# BIN15 O2: ROLLING HIP-4 families, "<out|native>:<COIN>:<15m|1d>".
# Only those two pairings exist on the venue; the crossed forms refuse
# the boot. Absent or empty is the pre-BIN15 boot, bit for bit.
#
# A family is NOT an instrument. It owns two reserved SymbolId slots
# (Yes and No) from an ordinal pool above every `coins` ordinal, and
# the venue coin under those slots is REBOUND as instances are created
# and settle — the BTC 15-minute family rolls 96 times a day. Every
# rebind is captured as a `ChannelId::InstrumentRoll` event, which is
# what tells an offline reader which instance a slot meant at a time;
# `instrument-manifest.tsv` stays two columns and names only the slot.
#
# Cost: two rows of the 32-row coin table per family, three
# subscriptions per row. A family whose instance is not live on the
# venue at boot starts DORMANT and subscribes nothing until its next
# `outcomeCreated` push.
rolling = []

[bybit]
# WS9: the sixth venue. UPPERCASE venue symbols ([A-Z0-9] — topics
# and REST take them verbatim). spot[i] → make_symbol_id(Bybit, i+1);
# linear ordinals from base 512 (the Binance spot/usdm split).
# One thread, one connection per configured class:
#   spot   → orderbook.1 (BBO ticks) + publicTrade (Trade events)
#   linear → the same + tickers (Mark/Funding/OI capture events)
# Hosts: BYBIT_WS_HOST / BYBIT_REST_HOST (.env; sane defaults).
spot = []                  # e.g. ["BTCUSDT"]
linear = []                # e.g. ["BTCUSDT", "ETHUSDT"]

[mexc]
# MX5. Spot symbols are UPPERCASE, no separator (BTCUSDT, AAPLXUSDT);
# tokenized xStocks equities are ORDINARY spot rows — no separate key.
# spot[i] -> make_symbol_id(Mexc, i+1); perp ordinals from base 512.
# Spot rides ONE connection per 30 subscriptions (venue cap, measured);
# 2 channels per symbol => 15 symbols per spot connection.
spot = []   # e.g. ["BTCUSDT", "ETHUSDT", "AAPLXUSDT", "SPYXUSDT"]

# Perp symbols are BASE_QUOTE (BTC_USDT, XAU_USDT, AAPLSTOCK_USDT).
# TradFi/commodity/FX/index perps are ORDINARY rows — no separate key.
# BBO comes from depth.full(limit 5) at ~270 ms, NOT push.ticker (~2.75 s).
perp = []   # e.g. ["BTC_USDT", "XAU_USDT", "USOIL_USDT", "EUR_USDT", "SPY_USDT"]

[hyperevm]
# HYPARB H3b. One entry per AMM pool, "0x<address>:<family>:<dec0>:<dec1>":
#   address — the POOL contract, 40 LOWERCASE hex (the descriptor is
#             hyperevm:0x<address>; one spelling, so one identity);
#   family  — v3 (Uniswap V3 ABI, Hyperswap V3 included) |
#             slipstream (Aerodrome fork) | algebra (Algebra Integral
#             v1.0 / v1.2);
#   dec0/1  — token0 / token1 decimals() (0..=36). CHECKED on chain before
#             every snapshot: a mismatch refuses that pool, never misprices it.
# pools[i] -> make_symbol_id(HyperEvm, i+1); at most 128. APPEND, never
# reorder — a reordered list re-keys every pool on the tape. Ingested only
# with --hyperevm-path on HYPEREVM_WS_HOST (an archive-honest endpoint).
pools = []  # e.g. ["0x6c9a33e3b592c0d65b3ba59355d5be0d38259285:v3:18:6"]

[hypercall]
# HC4 (ruling O-HC1: DATA-ONLY — no keys, no exec arm). Underlyings as
# Hypercall names them, UPPERCASE [A-Z0-9] (SP500, SPCX, MU, BTC, …).
# Each underlying:
#   - names its settlement index, hypercall-idx:<U> at ordinal i+1;
#   - is chain-capped at boot from GET /markets: the `expiries` nearest
#     series OUTSIDE the provider's 2 h pre-expiry quoting blackout ×
#     the `strikes` nearest the index (K/2 at-or-below + K/2 above),
#     calls AND puts — options allocated from ordinal 513 in selection
#     order (they reshuffle every boot: options-manifest.tsv resolves).
# underlyings × expiries × strikes × 2 ≤ 1024 (the ONE-frame indicative
# subscribe; the venue closes a socket that subscribes in pieces).
# summary_every_s: each underlying's REST /options-summary refresh
# (marks, IV, greeks, OI), staggered; 60..=3600, default 300.
# Hosts: HYPERCALL_WS_HOST / HYPERCALL_REST_HOST (.env; sane defaults).
underlyings = []  # e.g. ["SP500", "SPCX", "MU", "NVDA", "MSFT", "META", "AAPL", "BABA", "SNDK", "BOT", "BTC", "ETH"]
# expiries = 3
# strikes = 8
# summary_every_s = 300

[pairs]
# Latency-arb pairs: "P:B" = polymarket.markets[P] × binance.spot[B]
# (0-based file order; a YES/NO market entry resolves to its YES token).
# Empty/absent with both sides configured ⇒ default pair "0:0".
map = ["0:0"]

# BST (binance-stocks-plan): equities ride the SAME lists — bStocks
# (`<ticker>busdt`) append to [binance] spot, TradFi perps to usdm
# (both 24/7; usdm rows carry contractType TRADIFI_PERPETUAL +
# underlyingType EQUITY — structurally skipped fields). PM equity
# dailies (20:00Z EDT / 21:00Z EST close, trading days only) append
# AFTER the crypto dailies block and pair with the bStocks tail via
# [pairs]. The BST3 [equity_dailies] refresher family owns the PM
# entries; [pairs] is never rewritten.
