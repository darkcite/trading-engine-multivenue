# --- secrets ---
.env
.env.*
!.env.example

# key material — belt-and-braces for the public repo. Nothing tracked
# matches these; they exist so a stray key can never be `git add`ed.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
id_ecdsa*
*.asc
*.gpg
.netrc
.pypirc
.npmrc
credentials
credentials.json
secrets.*
service-account*.json

# --- Rust ---
target/
**/*.rs.bk
Cargo.lock.bak

# fuzz corpus/artifacts we don't want to vendor
fuzz/corpus/
fuzz/artifacts/
fuzz/target/

# criterion output
criterion/

# dhat profiling output
dhat-heap.json
dhat-*.json

# --- Python / claude-worker ---
claude-worker/.venv/
claude-worker/__pycache__/
claude-worker/**/__pycache__/
claude-worker/**/*.pyc
claude-worker/.pytest_cache/
claude-worker/.ruff_cache/
claude-worker/.mypy_cache/
claude-worker/dist/
claude-worker/build/
claude-worker/*.egg-info/
claude-worker/uv.lock.bak

# --- runtime data ---
~/multivenue/
logs/
*.log
*.hgrm
replay/
snapshots/

# --- editor / OS ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
.nvimrc.local

# --- Claude local session scratch ---
.claude/cache/
.claude/local/

# --- external material, provenance unconfirmed ---
# Third-party strategy research from a separate engagement. No authorship,
# copyright or license statement of its own; references source documents
# that are not in this repo. Nothing from it may enter git history until
# ownership/relicensing is confirmed and recorded in NOTICE.
# See docs/license-audit-2026-08-27.md G8.
EXTERNAL STRATEGIES TO ONBOARD/

# NOTE: THIRD-PARTY-NOTICES.md is deliberately NOT ignored. It is generated
# by `make license-deps` but must be committed: it has to ship beside every
# distributed binary, and an ignored file is one that can be missing at
# release time. Regenerate it, never hand-edit it.
