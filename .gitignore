*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
id_ecdsa*
*.asc
*.gpg
.netrc
.pypirc
.npmrc
credentials
credentials.json
secrets.*
service-account*.json

# --- Rust ---
target/
**/*.rs.bk
Cargo.lock.bak

